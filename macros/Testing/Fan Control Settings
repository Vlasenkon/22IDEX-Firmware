; Fan Control Settings Macro
; Simple fan control for HEPA fan, chamber heater fan, and chamber air fan

; HEPA Fan Control (Fan P7)
M291 R"HEPA Fan Control" P"Select HEPA fan control mode:" K{"Off (0%)","Full Speed (100%)","Custom Speed (%)","Thermostatic Control"} S4
var hepaMode = input

if var.hepaMode == 0
    ; Off mode
    M106 P7 H-1 S0
    echo "HEPA fan turned off"
elif var.hepaMode == 1
    ; Full speed mode
    M106 P7 H-1 S1.0 X1.0
    echo "HEPA fan set to full speed (100%)"
elif var.hepaMode == 2
    ; Custom speed mode
    M291 S5 F50 L0 H100 R"Custom HEPA Fan Speed" P"Enter HEPA fan speed percentage (0-100%):"
    var hepaSpeed = input / 100.0
    M106 P7 H-1 S{var.hepaSpeed} X{var.hepaSpeed}
    echo "HEPA fan set to " ^ input ^ "% speed"
else
    ; Thermostatic control mode
    M98 P"0:/user/hepafan.g"
    M106 P7 H3 T50 X{global.hepafan}
    echo "HEPA fan set to thermostatic control"

; Chamber Heater Fan Control (Fan P4)
M291 R"Chamber Heater Fan Control" P"Select chamber heater fan control mode:" K{"Off (0%)","Full Speed (100%)","Custom Speed (%)","Thermostatic Control"} S4
var chamberHeaterMode = input

if var.chamberHeaterMode == 0
    ; Off mode
    M106 P4 H-1 S0
    echo "Chamber heater fan turned off"
elif var.chamberHeaterMode == 1
    ; Full speed mode
    M106 P4 H-1 S1.0
    echo "Chamber heater fan set to full speed (100%)"
elif var.chamberHeaterMode == 2
    ; Custom speed mode
    M291 S5 F50 L0 H100 R"Custom Chamber Heater Fan Speed" P"Enter chamber heater fan speed percentage (0-100%):"
    var chamberHeaterSpeed = input / 100.0
    M106 P4 H-1 S{var.chamberHeaterSpeed}
    echo "Chamber heater fan set to " ^ input ^ "% speed"
else
    ; Thermostatic control mode
    M106 P4 H4 T80 S1 B1
    echo "Chamber heater fan set to thermostatic control"