; ---- User confirmation ----
M291 S4 K{"Start extrusion","Cancel"} R"Continuous Extrusion Test" P"This will continuously extrude plastic at 5mm/s.<br>Ensure filament is loaded.<br>Press any endstop to stop."

if input != 0
  abort "Test cancelled by user."

; ---- Tool selection ----
M291 S4 K{"T0","T1","T3"} R"Tool Selection" P"Select which tool to use for extrusion test:"
var selectedTool = input

echo "Selected tool: T" ^ var.selectedTool

; ---- Variables ----
var extrusionSpeed = 5           ; mm/s extrusion speed
var totalExtruded = 0           ; track total amount extruded
var startTime = state.time      ; for duration tracking

; ---- Temperature check and heating ----
echo "Checking temperature for T" ^ var.selectedTool
var currentActiveTemp = heat.heaters[var.selectedTool].active
var currentTemp = heat.heaters[var.selectedTool].current

echo "Current active temperature: " ^ var.currentActiveTemp ^ "°C"
echo "Current measured temperature: " ^ var.currentTemp ^ "°C"

if var.currentActiveTemp < 180
  echo "Tool temperature is set below 180°C, requesting target temperature"
  
  ; Ask user for desired temperature
  M291 S5 R"Temperature Setting" P"Enter target temperature (°C):" L180 H300
  var targetTemp = input
  
  echo "Setting tool T" ^ var.selectedTool ^ " to " ^ var.targetTemp ^ "°C"
  
  ; Set blue LED to indicate heating
  M98 P"0:/sys/led/start_cold.g"       ; BLUE = heating

  ; Set tool temperature
  M568 P{var.selectedTool} S{var.targetTemp} A{var.targetTemp}
  
  ; Wait for temperature to be reached
  echo "Waiting for temperature to reach " ^ var.targetTemp ^ "°C..."
  M116 P{var.selectedTool}       ; Wait for tool to reach temperature
  
  echo "Temperature reached!"
else
  echo "Tool is already at suitable temperature (" ^ var.currentActiveTemp ^ "°C)"

; ---- Set LED to indicate active test ----
M98 P"0:/sys/led/pause.g"       ; YELLOW = active test

; ---- Select and prepare tool ----
T{var.selectedTool}             ; Select the chosen tool

; ---- Set relative extrusion mode ----
M83                             ; Relative extruder moves

echo "Starting continuous extrusion at " ^ var.extrusionSpeed ^ "mm/s"
echo "Press any endstop to stop the test"

; ---- Main extrusion loop ----
while true
  ; Check all endstops for emergency stop
  if sensors.endstops[0].triggered || sensors.endstops[3].triggered
    break

  ; Extrude 1mm at specified speed (small increments for responsive stopping)
  G1 E1 F{var.extrusionSpeed * 60}  ; Convert mm/s to mm/min for feedrate
  M400                               ; Wait for move to complete before next command
  
  ; Update tracking variables
  set var.totalExtruded = var.totalExtruded + 1

; ---- Cleanup and results ----
; Calculate final statistics
var finalTime = floor(state.time - var.startTime)
var avgSpeed = 0
if var.finalTime > 0
  set var.avgSpeed = var.totalExtruded / var.finalTime

; Stop extrusion and set LED to success
M98 P"0:/sys/led/end.g"         ; GREEN = test complete

; Display results
M291 S2 R"Extrusion Test Complete" P"Total extruded: " ^ var.totalExtruded ^ "mm<br>Duration: " ^ var.finalTime ^ "s<br>Average speed: " ^ var.avgSpeed ^ "mm/s"

echo "Continuous extrusion test complete:"
echo "- Total extruded: " ^ var.totalExtruded ^ "mm"
echo "- Duration: " ^ var.finalTime ^ "s"
echo "- Average speed: " ^ var.avgSpeed ^ "mm/s"
echo "Test stopped by endstop trigger"

; ---- Reset tool temperature to zero ----
echo "Cooling down nozzle..."
M568 P{var.selectedTool} S0 A0  ; Set tool temperature to 0°C (active and standby)
echo "Tool temperature reset to 0°C"