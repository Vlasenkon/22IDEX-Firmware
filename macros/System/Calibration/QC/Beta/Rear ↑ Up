M400
var step = -0.05


if exists(global.ycomp)
  set global.ycomp = {global.ycomp + var.step}
else
  global ycomp = var.step

; Update ycomp.g to save the new value
echo >"0:/user/ycomp.g" "if exists(global.ycomp)"
echo >>"0:/user/ycomp.g" "  set global.ycomp = "^{global.ycomp}
echo >>"0:/user/ycomp.g" "else"
echo >>"0:/user/ycomp.g" "  global ycomp = "^{global.ycomp}

if global.ycomp > 0
  echo "RHS of Build Plate will move Down by: "^abs(global.ycomp)^" mm"
elif global.ycomp < 0
  echo "RHS of Build Plate will move Up by: "^abs(global.ycomp)^" mm"
else
  echo "Compensation is set to 0"