      abort "Test cancelled by user"
    M302 P1
    T1 P0
    M83 ; Extruder to relative mode
    G1 E100 F1000 ; Feed filament
    M400
    M302 P0 ; Disallow cold extrudes
    T0 P0 
  ; ///// T1 Extruder Motor Direction Test End /////



T0 P0
M98 P"0:/sys/led/resetstatus.g"