; Start Test ========================================================================================================
M291 R"Test 1" P"Start test 1, follow the on-screen instructions" S2

; Check voltage for both boards
if boards[0].vIn.current < 23 || boards[0].vIn.current > 24.8
	M98 P"0:/sys/led/fault.g"
	abort "Board 0 voltage out of range: " ^ boards[0].vIn.current ^ "V"

; Test Voltage // add 5V PSU test====================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Voltage"

; LED Test ==========================================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/LED"

; Endstop Test ======================================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Endstop"

; XYZ - Motor Direction & Connection Test ===========================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Motor Direction"

;=======================================================================================================================
; Fixing the motor screws
M98 P"0:/macros/System/Calibration/Testing/Tests/Z screws fixing"

; Homing Test =======================================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Homing"

; Probes Test =======================================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Probe"

; Left Head Test ====================================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Head Left"

; Right Head Test ===================================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Head Right"

; Bed Heating Test ==================================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Bed Heating Test"

; Chamber Heater & Fan Test  ========================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Chamber Heater + Fan"

; Test Y - Homming Error ============================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/HomeY"

; Calibrate Z - Probe // Servo rotation test // Z-Probe Pickup Angle // Height // Z-Probe Pickup Position ===========
M98 P"0:/macros/System/Calibration/Testing/Tests/Probe Calibration"

; Tigten Nozles & Adjust Purging Backets ============================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Nozzle & Purge"

; True Bed Leveling Test ============================================================================================
M98 P"0:/macros/System/Calibration/Testing/Tests/Lube"


M98 P"0:/sys/led/end.g"
M291 R"Test 1 completed" P"Congratulations test 1 completed" S2
M98 P"0:/sys/led/resetstatus.g"