M291 R"Endstop Test" P"Do you want to start the endstop test?" S4 K{"Test","Skip","Cancel"}
if input == 1
    M99
elif input == 2
    abort "Error: Test cancelled by user"

; Endstop Test Macro
M84
;-----------------------------------------------------------------------------------------------------------------
; Test Left-hand side Y-axis endstop (io1.in)
M574 Y1 S1 P"io1.in"                              ; Configure Y-axis to use only io1.in
M291 R"Testing Left Y-axis Endstop" P"Please click 'Ok' and press the Left Y-axis endstop to test. Or click 'Next' to skip" S4 K{"Ok", "Next"}
if input == 0 
    if sensors.endstops[1].triggered == true
        M291 R"Error: Left Y-axis endstop is already triggered" P"Please release the endstop and try again." S2
        abort "Error: Left Y-axis endstop is already triggered. Please release the endstop and try again."
    while !sensors.endstops[1].triggered
        G4 P100  ; Wait for the endstop to be triggered
    M291 R"Left-hand side Y-axis endstop Test Complete" P"Left-hand side Y-axis endstop triggered successfully" S2
;-----------------------------------------------------------------------------------------------------------------
; Test Right-hand side Y-axis endstop (io2.in)
M574 Y1 S1 P"io2.in"                              ; Configure Y-axis to use only io2.in
M291 R"Testing Right Y-axis Endstop" P"Please click 'Ok' and press the Right Y-axis endstop to test. Or click 'Next' to skip" S4 K{"Ok", "Next"}
if input == 0
    if sensors.endstops[1].triggered == true
        M291 R"Error: Right Y-axis endstop is already triggered." P"Please release the endstop and try again." S2
        abort "Error: Right Y-axis endstop is already triggered. Please release the endstop and try again."
    while !sensors.endstops[1].triggered
        G4 P100
    M291 R"Right-hand side Y-axis endstop Test Complete" P"Right-hand side Y-axis endstop triggered successfully" S2
;-----------------------------------------------------------------------------------------------------------------
; Restore Y-axis endstop configuration
M574 Y1 S1 P"io1.in+io2.in"                       ; Restore original Y-axis endstop configuration

;-----------------------------------------------------------------------------------------------------------------
; Test X-axis endstop (io4.in)
M291 R"Testing X-axis Endstop" P"Please click 'Ok' and press the X-axis endstop to test. Or click 'Next' to skip" S4 K{"Ok", "Next"}
if input == 0
    if sensors.endstops[0].triggered == true
        M291 R"Error: X-axis endstop is already triggered." P"Please release the endstop and try again." S2
        abort "Error: X-axis endstop is already triggered. Please release the endstop and try again."
    while !sensors.endstops[0].triggered
        G4 P100
    M291 R"X-axis endstop Test Complete" P"X-axis Endstop triggered successfully" S2

;-----------------------------------------------------------------------------------------------------------------
; Test U-axis endstop (io5.in)
M291 R"Testing U-axis Endstop" P"Please click 'Ok' and press the U-axis endstop to test. Or click 'Next' to skip" S4 K{"Ok", "Next"}
if input == 0
    if sensors.endstops[3].triggered == true
        M291 R"Error: U-axis endstop is already triggered." P"Please release the endstop and try again." S2
        abort "Error: U-axis endstop is already triggered. Please release the endstop and try again."
    while !sensors.endstops[3].triggered
        G4 P100
    M291 R"U-axis endstop Test Complete" P"U-axis endstop triggered successfully" S2
;----------------------------------------------------------------------------------------------------------------
; Test Left Filament Sensor
M291 R"Testing Left Filament Sensor" P"Please click 'Ok' to test. Or click 'Next' to skip" S4 K{"Ok", "Next"}
if input == 0
    while sensors.filamentMonitors[0].status != "ok"
        M291 R"Testing Left Filament Sensor" P"Insert a filament" S0
    while sensors.filamentMonitors[0].status == "ok"
        M291 R"Filament Sensor Trigger" P"Please remove the filament to check the status of the Filament Sensor" S0
        if sensors.filamentMonitors[0].status != "ok"
            M291 R"Filament Sensor Not Trigger" P"Filament not detected" S0
    M291 R"Left Filament Sensor Test Complete" P"Left Filament Sensor is working correctly" S2
;---------------------------------------------------------------------------------------------------------------
; Test Right Filament Sensor
M291 R"Testing Right Filament Sensor" P"Please click 'Ok' to test. Or click 'Next' to skip" S4 K{"Ok", "Next"}
if input == 0
    while sensors.filamentMonitors[1].status != "ok"
        M291 R"Testing Right Filament Sensor" P"Insert a filament" S0
    while sensors.filamentMonitors[1].status == "ok"
        M291 R"Filament Sensor Trigger" P"Please remove the filament to check the status of the Filament Sensor" S0
        if sensors.filamentMonitors[1].status != "ok"
            M291 R"Filament Sensor Not Trigger" P"Filament not detected" S0
    M291 R"Right Filament Sensor Test Complete" P"Right Filament Sensor is working correctly" S2