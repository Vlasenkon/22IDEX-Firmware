M291 R"Home Y - Correction Test" P"Do you want to start the Home Y Test?" S4 K{"Test","Skip","Cancel"}
if input == 1
    M99
elif input == 2
    abort "Test cancelled by user"

M98 P"0:/sys/homey.g"
M98 P"0:/sys/homex.g"
M98 P"0:/sys/homeu.g"

M291 R"Home Y Test" P" " S3
M98 P"0:/sys/homey.g" T1
G91
G1 H2 X-10 U10 F18000
M400
G4 P300
var dis1 = global.HomeYDis
M291 R"Home Y Test 1" P{"The "^{global.HomeYSide}^" side was adjusted by "^{global.HomeYDis}^" mm"} S2

M98 P"0:/sys/homey.g" T1
G91
G1 H2 X-10 U10 F18000
M400
G4 P300
var dis2 = global.HomeYDis
M291 R"Home Y Test 2" P{"The "^{global.HomeYSide}^" side was adjusted by "^{global.HomeYDis}^" mm"} S2

M98 P"0:/sys/homey.g" T1
G91
G1 H2 X-10 U10 F18000
M400
G4 P300
var dis3 = global.HomeYDis
M291 R"Home Y Test 3" P{"The "^{global.HomeYSide}^" side was adjusted by "^{global.HomeYDis}^" mm"} S2

var avgDis = (var.dis1 + var.dis2 + var.dis3) / 3

var null = ""
if var.avgDis < 0.1
  set var.null = "0"

var strDisRounded = "0." ^ {var.null} ^ {floor(var.avgDis*1000)}

if var.avgDis < 0.4
  M98 P"0:/sys/led/end.g"
  M291 R"Home Y Information" P{"Average Adjustment: "^{var.strDisRounded}^" mm"} S2
else
  M98 P"0:/sys/led/fault.g"
  M291 R"Error" P{"Average Adjustment is: "^{var.strDisRounded}^" mm. Please move "^{global.HomeYSide}^" Y-endstop by "^{var.strDisRounded}^" mm away from the door, then run the test again."} S2
  M98 P"0:/macros/System/Calibration/Testing/Tests/HomeY"

M98 P"0:/sys/led/resetstatus.g"