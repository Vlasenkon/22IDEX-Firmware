M564 H0
;=======================================================================================================================
;Testing XYU - Axis Connection
M291 R"Move Tools by Hand" P"Movement should be smooth and without binding" S4 K{"Ok","Skip","Cancel"}

if input == 0
    M291 R"Move XYU - Axis" P"The XYU-Axis should move smoothly and without unnecessary noise during operation" S3 X1 Y1 U1
    M302 P0
    M564 H1
elif input == 2
    abort "Test cancelled by user"
    
;=======================================================================================================================
;Z - Motor Connection Test
M291 R"Z - Motor Connection Test" P"Each motor will move in sequence: Left, Right, Rear" S4 K{"Test","Skip","Cancel"}
if input == 1
    M99
elif input == 2
    abort "Test cancelled by user"
M564 H0

; Move Left lead screw
M291 R"Left Z-motor test" P"The left Z motor should go down by 10 units, up by 20 units, and down by 10 units again" S4 K{"Ok", "Cancel"}
if input == 1
    abort "Test cancelled by user"
elif input == 0
    M584 Z1.2     ; define driver mapping
    G91               ; set to relative positioning
    G1 F18000 Z10    ; move 10mm down
    G1 F18000 Z-20     ; move 20mm up
    G1 F18000 Z10    ; move 10mm down back to original position
    G90               ; set to absolute positioning
M400
;=======================================================================================================================
; Move Right lead screw
M291 R"Right Z-motor test" P"The right Z motor should go down by 10 units, up by 20 units, and down by 10 units again" S4 K{"Ok", "Cancel"}
if input == 1
    abort "Test cancelled by user"
elif input == 0
    M584 Z1.0     ; define driver mapping
    G91               ; set to relative positioning
    G1 F18000 Z10    ; move 10mm down
    G1 F18000 Z-20     ; move 20mm up
    G1 F18000 Z10    ; move 10mm down back to original position
    G90               ; set to absolute positioning
M400
;=======================================================================================================================
