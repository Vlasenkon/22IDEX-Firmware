M291 S4 K{"Start test", "Cancel"} R"Chamber Heating Test" P"The printer will heat up to high temperatures<br>Remove any low-melting materials from the chamber.<br>You can end the test early by holding down the X or U endstops."
if input == 1
    abort "Test cancelled by user."

M141 S0
M140 S0
M568 P0 S0
M568 P1 S0
M568 P2 S0
M568 P3 S0

M98 P"0:/sys/homeall.g" S1
G90
G1 X-100 U100

var runLogging = true        ; Control flag (manual stop)
var counter = 0              ; Seconds elapsed
var clcount = 0
var htcount = 0

; Create CSV header
echo >"0:/sys/Tuning/PA.csv" "Time,Elapsed_s,Tool0_Temp,Tool1_Temp,Bed_Temp,Chamber_Temp"
M291 S1 R"Printer cooling" P"Wait for the printer to cool down and the temperature to stabilize<br>To speed up the process, open the printer’s door and lid"
while var.runLogging

    if sensors.endstops[0].triggered || sensors.endstops[3].triggered
        abort "Test canceled due to triggered XU endstops"

    if heat.heaters[0].current < 35 && heat.heaters[1].current < 35 && heat.heaters[2].current < 35 && heat.heaters[3].current < 35
        if var.clcount == 0
            set var.clcount = iterations + 900
        if var.counter == var.clcount
            M291 S2 R"Close the door and lid" P"The printer will start heating<br>Make sure to close the door and lid"
            M141 S100
            M140 S130
    elif iterations == 3600 && var.clcount == 0
        abort "Error: the printer took too long to cool down"
    if heat.heaters[3].current >= 100 && var.clcount > 0
        if var.htcount == 0
            set var.htcount = iterations + 600
        if var.counter == var.htcount
            M141 S0
            M140 S0
            M291 S2 R"Chamber heating test complete" P"The test results are in the file PA.csv, located under the Settings tab in the Tuning folder."
            break

    var now = state.time
    var t0 = heat.heaters[0].current
    var t1 = heat.heaters[1].current
    var bed = heat.heaters[2].current
    var chamber = heat.heaters[3].current

    ; Append to CSV: Time, Elapsed seconds, Temps
    echo >>"0:/sys/Tuning/PA.csv" {var.now ^ "," ^ var.counter ^ "," ^ var.t0 ^ "," ^ var.t1 ^ "," ^ var.bed ^ "," ^ var.chamber}

    ; Echo chamber temperature to console
    if mod(iterations, 30) == 0
        echo "Chamber Temp: " ^ var.chamber ^ " °C"

    ; Wait 1 second
    G4 S1

    ; Increment elapsed seconds
    set var.counter = var.counter + 1