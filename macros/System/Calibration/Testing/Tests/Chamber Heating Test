; ============================================================
; Chamber Heating Test
; - Confirms start
; - Sets temps to 0, cools if any heater ≥35C (blue LED macro)
; - Prompts to close door/lid, then heats chamber/bed (yellow LED macro)
; - Logs temps every second to 0:/sys/Testing/Chamber_Heater
; - Stops when X or U endstop is held OR chamber reaches 100C
; - Green if within target time, Red if slower than expected
; ============================================================

; ---- User confirmation ----
M291 S4 K{"Start test","Cancel"} R"Chamber Heating Test" P"The printer will heat up to high temperatures.<br>Remove any low-melting materials from the chamber.<br>You can end the test early by holding down the X or U endstops."
if input == 1
  abort "Test cancelled by user."

; ---- Ensure all heaters are off ----
M140 S0                          ; bed heater OFF
M141 S0                          ; chamber heater OFF
M568 P0 R0 S0 A0
M568 P1 R0 S0 A0
M568 P2 R0 S0 A0
M568 P3 R0 S0 A0

; ---- Variables ----
var coolElapsed = 0              ; seconds spent cooling (for timeout only)
var expectedHeatSeconds = 600    ; target time budget (10 min)
var startTime = 0.0
var heatDuration = 0
var tookTooLong = false
var elapsed = 0                  ; seconds since heating started

; ---- CSV header (now includes elapsed column) ----
echo >"0:/sys/Result/Chamber_Heater.csv" "Time,Elapsed_s,Tool0_Temp,Tool1_Temp,Bed_Temp,Chamber_Temp,Chamber_Heater_Temp"

; ---- Helper scratch ----
var t0 = 0
var t1 = 0
var bed = 0
var chamber = 0
var ch_heater = 0

; ---- If anything is ≥35C, show cooling popup + BLUE LED macro ----
if (heat.heaters[0].current >= 35) || (heat.heaters[1].current >= 35) || (heat.heaters[2].current >= 35) || (heat.heaters[3].current >= 35)
  M291 S1 R"Printer cooling" P"Wait for the printer to cool down and the temperature to stabilize.<br>To speed it up, open the door and lid."
  M98 P"0:/sys/led/start_cold.g" ; BLUE

                                 ; Cooling loop: check every second until ALL heaters <35C
  while true
    if sensors.endstops[0].triggered || sensors.endstops[3].triggered
      M98 P"0:/sys/led/fault.g"  ; RED
      abort "Test canceled due to triggered X/U endstop during cooling."

    set var.t0 = heat.heaters[0].current
    set var.t1 = heat.heaters[1].current
    set var.bed = heat.heaters[2].current
    set var.chamber = heat.heaters[3].current
    set var.ch_heater = sensors.analog[4].lastReading

    if var.t0 < 35 && var.t1 < 35 && var.bed < 35 && var.chamber < 35
      break

    if mod(iterations, 30) == 0
      echo "Cooling... T0:"^var.t0^"  T1:"^var.t1^"  Bed:"^var.bed^"  Chamber:"^var.chamber^"  Chamber heater:"^var.ch_heater^"  (°C)"

    G4 S1
    set var.coolElapsed = var.coolElapsed + 1
    if var.coolElapsed > 3600
      M98 P"0:/sys/led/fault.g"  ; RED
      abort "Error: the printer took too long to cool down."

; ---- Prompt to close up, then start heating (switch to YELLOW LED macro) ----
M291 S2 R"Close the door and lid" P"The printer will start heating the chamber.<br>Make sure the door and lid are closed."
M98 P"0:/sys/homeall.g"
G90
G1 X-100 U100
M98 P"0:/sys/led/pause.g"        ; YELLOW = active / heating

; Start heaters for the test (adjust as needed)
M141 S100                        ; chamber target
M140 S180                        ; bed target (helps chamber heat)

; Mark start time for duration calc (we aren't logging elapsed per-second)
set var.startTime = state.time

; ---- Logging loop: once per second ----
; Stop ONLY when (X or U endstop held) OR (chamber >= 100C)
while true
  if sensors.endstops[0].triggered || sensors.endstops[3].triggered
    M141 S0
    M140 S0
    M98 P"0:/sys/led/fault.g"    ; RED
    abort "Test canceled due to triggered X/U endstop."

                                 ; Sample temps
  var now = state.time
  set var.elapsed = floor(var.now - var.startTime)
  set var.t0 = heat.heaters[0].current
  set var.t1 = heat.heaters[1].current
  set var.bed = heat.heaters[2].current
  set var.chamber = heat.heaters[3].current
  set var.ch_heater = sensors.analog[4].lastReading

                                 ; Append to CSV (Time, Elapsed, T0, T1, Bed, Chamber)
  echo >>"0:/sys/Result/Chamber_Heater.csv" {var.now^","^var.elapsed^","^var.t0^","^var.t1^","^var.bed^","^var.chamber^","^var.ch_heater}

                                 ; Console heartbeat every ~30s
  if mod(iterations, 30) == 0
    echo "Heating... Chamber: "^var.chamber^" °C, Chamber heater: "^var.ch_heater^" °C"

                                 ; Stop condition: chamber at/over 100C
  if var.chamber >= 100
    break

  G4 S1

; ---- Wrap up ----
; Power down heaters
M141 S0
M140 S0

; Compute duration and evaluate target (no per-second elapsed logged)
set var.heatDuration = floor(state.time - var.startTime)
if var.heatDuration > var.expectedHeatSeconds
  set var.tookTooLong = true

; ---- Final LEDs + message ----
if var.tookTooLong
  M98 P"0:/sys/led/fault.g"      ; RED
  M291 S2 R"Chamber heating test complete (SLOW)" P{"Chamber reached 100°C, but exceeded the target "^var.expectedHeatSeconds^" s (actual "^var.heatDuration^" s).<br>Results: Settings → Result → PA.csv"}
else
                                 ; If you have a green LED macro, replace the next line with: M98 P"0:/sys/led/success.g"
  M150 R0 U255 B0                ; GREEN success (Neopixel)
  M291 S2 R"Chamber heating test complete" P{"Chamber reached 100°C in "^var.heatDuration^" s.<br>Results saved to Settings → Result → PA.csv"}