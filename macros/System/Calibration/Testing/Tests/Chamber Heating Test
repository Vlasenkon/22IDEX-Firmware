; ---- User confirmation ----
M291 S4 K{"Start test","Start (No fault detection)","Cancel"} R"Chamber Heating Test" P"The printer will heat to high temps.<br>Remove low-melting materials.<br>Hold X or U endstop to abort."

; Variable to track fault detection state
var disableFaultDetection = false

if input == 0
  ; Start test normally - fault detection remains enabled
  echo "Starting chamber heating test with normal fault detection"
elif input == 1
  ; Start test with disabled chamber fault detection
  set var.disableFaultDetection = true
  echo "Starting chamber heating test with disabled fault detection"
  M570 H3 P999999 T999999 R50    ; Disable chamber fault detection
else
  abort "Test cancelled by user."

; ---- Ensure all heaters are off ----
M140 S0                          ; bed heater OFF
M141 S0                          ; chamber heater OFF
M568 P0 R0 S0 A0
M568 P1 R0 S0 A0
M568 P2 R0 S0 A0
M568 P3 R0 S0 A0

; ---- Variables ----
var coolElapsed = 0              ; seconds spent cooling (for timeout only)
var expectedHeatSeconds = 600    ; target time budget (10 min)
var startTime = 0.0
var heatDuration = 0
var tookTooLong = false
var elapsed = 0                  ; seconds since heating started

; ---- CSV header (now includes elapsed column and Chamber Heater temp) ----
echo >"0:/sys/Testing/Chamber_Heater_Test.csv" "Time,Elapsed_s,Tool0_Temp,Tool1_Temp,Bed_Temp,Chamber_Air_Temp,Chamber_Heater_Temp"

; ---- Helper scratch ----
var t0 = 0
var t1 = 0
var bed = 0
var chamber = 0
var chamberHeater = 0

; ---- Chamber cooling wait prompt ----
M291 S4 K{"OK","Don't wait"} R"Chamber Cooling" P"Machine will automatically wait for the chamber to cool down."
var waitForCooling = (input == 0)

if var.waitForCooling
  echo "User selected to wait for chamber cooling"
else
  echo "User selected to skip cooling wait"
  
  ; ---- Axis homing and positioning (cooling skipped) ----
  ; Check if Z-axis is homed, if not perform G28 to home all axes
  if !move.axes[2].homed
    echo "Z-axis not homed, performing G28 to home all axes"
    G28                            ; Home all axes
    ; No need to set LED color here since no cooling phase occurred
  else
    echo "Z-axis already homed"
  
  ; Move Z-axis to global position 150mm
  echo "Moving Z-axis to position 150mm"
  G90                              ; Absolute positioning
  G0 Z150                          ; Move Z to 150mm
  echo "Z-axis positioned at 150mm"

; ---- If Tool 0, Tool 1, or chamber is ≥35C and user wants to wait, show cooling popup + BLUE LED macro ----
if var.waitForCooling && ((sensors.analog[0].lastReading >= 35) || (sensors.analog[1].lastReading >= 35) || (sensors.analog[3].lastReading >= 35))
  M98 P"0:/sys/led/start_cold.g" ; BLUE
  M291 S1 R"Cooling to ≤35°C" P"Cooling Tool 0, Tool 1, and chamber to below 35°C.<br>To speed cooling: open door and Lid.<br>Hold X or U endstop to skip."

                                 ; Cooling loop: check every second until Tool 0, Tool 1, and chamber <35C
  while true
    if sensors.endstops[0].triggered || sensors.endstops[3].triggered
      echo "Cooling wait skipped by endstop trigger - proceeding to next step"
      break  ; Skip cooling wait and continue

    set var.t0 = sensors.analog[0].lastReading
    set var.t1 = sensors.analog[1].lastReading
    set var.bed = sensors.analog[2].lastReading
    set var.chamber = sensors.analog[3].lastReading

    ; Only check Tool 0, Tool 1, and chamber - exclude bed from cooling check
    if var.t0 < 35 && var.t1 < 35 && var.chamber < 35
      break

    if mod(iterations, 60) == 0
      echo "Cooling to ≤35°C - Current: T0:" ^ var.t0 ^ "°C  T1:" ^ var.t1 ^ "°C  Chamber:" ^ var.chamber ^ "°C  Bed:" ^ var.bed ^ "°C"

    G4 S1
    set var.coolElapsed = var.coolElapsed + 1
    if var.coolElapsed > 3600
      ; Restore fault detection if it was disabled
      if var.disableFaultDetection
        M570 H3 P600 T70 R5     ; Restore chamber fault detection to normal
      M98 P"0:/sys/led/fault.g"  ; RED
      abort "Error: the printer took too long to cool down."

  ; ---- Cooling complete - show success (green LED) ----
  M98 P"0:/sys/led/end.g" ; GREEN success - cooling complete
  G4 S3  ; Hold green LED for 3 seconds so user sees it
  M291 S4 K{"Continue","Cancel"} R"Cooling Complete" P"The printer has cooled down successfully.<br>Ready to start chamber heating test.<br><br>Click Continue to proceed."
  
  if input != 0
    abort "Test cancelled by user after cooling."

; ---- Axis homing and positioning (after cooling) ----
; Check if Z-axis is homed, if not perform G28 to home all axes
if !move.axes[2].homed
  echo "Z-axis not homed, performing G28 to home all axes"
  G28                            ; Home all axes
  ; G28 resets LED color, so restart green LEDs after homing to maintain success indication
  M98 P"0:/sys/led/end.g"        ; GREEN = success maintained
else
  echo "Z-axis already homed"

; Move Z-axis to global position 150mm
echo "Moving Z-axis to position 150mm"
G90                              ; Absolute positioning
G0 Z150                          ; Move Z to 150mm
echo "Z-axis positioned at 150mm"

; ---- Test duration prompt (for all scenarios) ----

; ---- Test duration prompt (for all scenarios) ----
M291 S4 K{"OK","Set custom time"} R"Test Duration" P"Machine will test the chamber heating for two hours, what temperature it will reach."
var useCustomTime = (input == 1)
var testDurationSeconds = 7200  ; Default 2 hours

if var.useCustomTime
  ; Ask for custom time in minutes (30-300 minutes = 0.5 to 5 hours)
  M291 S5 R"Custom Test Duration" P"Enter test duration in minutes (30-300):" L30 H300
  set var.testDurationSeconds = input * 60  ; Convert minutes to seconds
  echo "Custom test duration set to " ^ (var.testDurationSeconds / 60) ^ " minutes (" ^ var.testDurationSeconds ^ " seconds)"
else
  echo "Using default test duration of " ^ (var.testDurationSeconds / 60) ^ " minutes (" ^ var.testDurationSeconds ^ " seconds)"

; ---- Prompt to close up, then start heating (switch to YELLOW LED macro) ----
M291 S2 R"Close the door and Lid" P"The printer will start heating the chamber.<br>Make sure the door and Lid are closed."
M98 P"0:/sys/led/pause.g"        ; YELLOW = active / heating

; Start heaters for the test (adjust as needed)
M141 S100                        ; chamber target
M140 S160                        ; bed target (helps chamber heat)

; Mark start time for overall test duration
set var.startTime = state.time
var heatUpStartTime = state.time
var targetReached = false
var heatUpDuration = 0

; ---- Wait for chamber to reach target temperature (100°C) with 2-hour timeout ----
echo "Waiting for chamber temperature to reach 100°C..."

; Wait for chamber temperature to reach within 2°C of target (98°C)
while !var.targetReached && ((state.time - var.heatUpStartTime) < var.testDurationSeconds)  ; Use configured test duration as timeout
  if sensors.endstops[0].triggered || sensors.endstops[3].triggered
    echo "Temperature waiting skipped by endstop trigger - proceeding to heat soak"
    set var.heatUpDuration = floor(state.time - var.heatUpStartTime)
    break  ; Skip heating wait and continue

  ; Check if chamber has reached target temperature (within 2°C)
  var chamberTemp = sensors.analog[3].lastReading
  if var.chamberTemp >= 98  ; Within 2°C of 100°C target
    set var.targetReached = true
    set var.heatUpDuration = floor(state.time - var.heatUpStartTime)
    break
  
  ; Display progress every 30 seconds
  var heatElapsed = floor(state.time - var.heatUpStartTime)
  if mod(var.heatElapsed, 30) == 0
    var remainingTime = var.testDurationSeconds - var.heatElapsed
    var remainingMinutes = var.remainingTime / 60.0
    echo "Heating: Chamber " ^ var.chamberTemp ^ "°C (Target: 100°C) - Time remaining: " ^ var.remainingMinutes ^ " minutes (Hold X or U endstop to skip)"
  
  G4 S1  ; Wait 1 second

; Check for timeout
if !var.targetReached
  M141 S0
  M140 S0
  ; Restore fault detection if it was disabled
  if var.disableFaultDetection
    M570 H3 P600 T70 R5
  M98 P"0:/sys/led/fault.g"
  abort "Timeout: Chamber did not reach 100°C within " ^ (var.testDurationSeconds / 60.0) ^ " minutes"

echo "Chamber reached target temperature in " ^ (var.heatUpDuration / 60.0) ^ " minutes"

; ---- 15-minute heat soak period ----
; Switch to yellow LEDs when temperature is reached
M98 P"0:/sys/led/pause.g"        ; YELLOW = temperature reached, stabilizing

; Initialize variables for 15-minute stabilization countdown
var stabilizationStartTime = state.time
var remainingTime = 0
var lastUpdateTime = 0

echo "Temperature reached - starting 15-minute heat soak period"
    
; 15-minute stabilization period with 30-second updates and endstop monitoring
while !(sensors.endstops[0].triggered || sensors.endstops[3].triggered)
  set var.remainingTime = 900 - (state.time - var.stabilizationStartTime)  ; 900 seconds = 15 minutes
  
  ; Check if stabilization period is complete
  if var.remainingTime <= 0
    break
  
  ; Provide time update every 30 seconds
  if (state.time - var.lastUpdateTime) >= 30 || var.lastUpdateTime == 0
    set var.lastUpdateTime = state.time
    var minutesExact = var.remainingTime / 60.0
    echo "Heat soak in progress - Time remaining: " ^ var.minutesExact ^ " minutes (Hold X or U endstop to skip)"
  
  G4 S1  ; Wait 1 second before next check

; Calculate heat soak duration
var heatSoakDuration = floor(state.time - var.stabilizationStartTime)

; Check if stabilization was skipped by endstop
if sensors.endstops[0].triggered || sensors.endstops[3].triggered
  echo "Heat soak period skipped by endstop trigger - proceeding to logging phase"
else
  echo "Heat soak complete - chamber stabilized for " ^ (var.heatSoakDuration / 60.0) ^ " minutes"

; Display heating phase summary
echo "=== HEATING PHASE COMPLETE ==="
echo "Time to reach 100°C: " ^ (var.heatUpDuration / 60.0) ^ " minutes"
echo "Heat soak duration: " ^ (var.heatSoakDuration / 60.0) ^ " minutes"
echo "Total preparation time: " ^ ((var.heatUpDuration + var.heatSoakDuration) / 60.0) ^ " minutes"

; ---- Logging loop: once per second ----
; Stop ONLY when (X or U endstop held) OR test duration exceeded
while true
  if sensors.endstops[0].triggered || sensors.endstops[3].triggered
    M141 S0
    M140 S0
    ; Restore fault detection if it was disabled
    if var.disableFaultDetection
      M570 H3 P600 T70 R5       ; Restore chamber fault detection to normal
    M98 P"0:/sys/led/fault.g"    ; RED
    abort "Test canceled due to triggered X/U endstop."

                                 ; Sample temps
  var now = state.time
  set var.elapsed = floor(var.now - var.startTime)
  set var.t0 = sensors.analog[0].lastReading
  set var.t1 = sensors.analog[1].lastReading
  set var.bed = sensors.analog[2].lastReading
  set var.chamber = sensors.analog[3].lastReading
  set var.chamberHeater = sensors.analog[4].lastReading

                                 ; Append to CSV (Time, Elapsed, T0, T1, Bed, Chamber Air, Chamber Heater)
  echo >>"0:/sys/Testing/Chamber_Heater_Test.csv" {var.now ^ "," ^ var.elapsed ^ "," ^ var.t0 ^ "," ^ var.t1 ^ "," ^ var.bed ^ "," ^ var.chamber ^ "," ^ var.chamberHeater}

                                 ; Console heartbeat every ~30s
  if mod(iterations, 60) == 0
    echo "Heating... Chamber: " ^ var.chamber ^ " °C"

  ; ---- Hard timeout guard - check against total test time including prep
  var totalElapsed = var.elapsed + var.heatUpDuration + var.heatSoakDuration
  if var.totalElapsed > var.testDurationSeconds
    M141 S0
    M140 S0
    ; Restore fault detection if it was disabled
    if var.disableFaultDetection
      M570 H3 P600 T70 R5       ; Restore chamber fault detection to normal
    M98 P"0:/sys/led/fault.g"
    abort "Timeout: total test time exceeded " ^ (var.testDurationSeconds / 60) ^ " minutes."
  
  ; Remove the chamber temperature check since we already reached it during heat-up
  ; This loop now just logs data for the specified test duration

  G4 S1

; ---- Wrap up ----
; Power down heaters
M141 S0
M140 S0

; Restore fault detection if it was disabled
if var.disableFaultDetection == true
  echo "Restoring chamber fault detection to normal settings"
  M570 H3 P600 T70 R5           ; Restore chamber fault detection to normal

; Calculate total test duration including all phases
var totalTestDuration = floor(state.time - var.startTime)
var loggingDuration = var.totalTestDuration - var.heatUpDuration - var.heatSoakDuration

; ---- Final LEDs + comprehensive timing report ----
M98 P"0:/sys/led/end.g" ; Success - Green

; Display comprehensive test results
echo "=== CHAMBER HEATING TEST COMPLETE ==="
echo "Heat-up time to 100°C: " ^ (var.heatUpDuration / 60.0) ^ " minutes"
echo "Heat soak duration: " ^ (var.heatSoakDuration / 60.0) ^ " minutes" 
echo "Data logging duration: " ^ (var.loggingDuration / 60.0) ^ " minutes"
echo "Total test duration: " ^ (var.totalTestDuration / 60.0) ^ " minutes"
echo "Results saved to: Settings → Testing → Chamber_Heater_Test.csv"

M291 S2 R"Chamber Heating Test Complete" P"Test completed successfully!<br><br>Heat-up time: " ^ (var.heatUpDuration / 60.0) ^ " min<br>Heat soak: " ^ (var.heatSoakDuration / 60.0) ^ " min<br>Total time: " ^ (var.totalTestDuration / 60.0) ^ " min<br><br>Results: Settings → Testing → Chamber_Heater_Test.csv"

M80 S1