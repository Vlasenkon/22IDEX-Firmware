M291 R"Z - Axis Lubracation" P"Do you want to lubricate the Z-Axis?<br>Press and hold X or U endtop to stop" S4 K{"Start","Skip","Cancel"}
if input == 1
    M99
elif input == 2
    abort "Test cancelled by user"

if !move.axes[1].homed
    G28 Y
if !move.axes[0].homed
    G28 X
if !move.axes[3].homed
    G28 U
if !move.axes[2].homed
    G28 Z

G90
G1 X-100 U100 Y175 Z450 F3000
M400
M291 P"Wait for the bed to lower.<br>Lubricate the Z axes of the motors evenly with grease, press OK when finished " S3
M291 P"When the motor axes are evenly lubricated, press one of the X or U endstops" S1

var stopCycle = false

while var.stopCycle == false
    while move.axes[2].machinePosition < 450
        G1 Z{move.axes[2].machinePosition - 40} F3000
        G1 Z{move.axes[2].machinePosition + 20} F3000
        M400
        if sensors.endstops[0].triggered || sensors.endstops[3].triggered
            set var.stopCycle = true
            break

    while move.axes[2].machinePosition > 0
        G1 Z{move.axes[2].machinePosition + 40} F3000
        G1 Z{move.axes[2].machinePosition - 20} F3000
        M400
        if sensors.endstops[0].triggered || sensors.endstops[3].triggered
            set var.stopCycle = true
            break
            
M98 P"0:/sys/led/end.g"
G1 Z100 F3000
M98 P"0:/sys/led/resetstatus.g"

M291 P"Please wipe off any excess lubricant from the z motors and seals,<br> but be careful not to contaminate the printer." S1