;==============================================================================
; SIMPLIFIED CHAMBER TEMPERATURE SENSOR CALIBRATION
; Simple binary search calibration with 30-minute heating and 5-minute stabilization
;==============================================================================

; ---- User confirmation for fault detection ----
M291 S4 K{"Start test","Start (No fault detection)","Cancel"} R"Chamber Temperature Calibration" P"Start simplified chamber sensor calibration?<br><br>Remove low-melting materials first.<br>Hold X or U endstop to abort at any time."

; Track fault detection state
var disableFaultDetection = false

if input == 0
  echo "Starting calibration with normal fault detection"
elif input == 1
  set var.disableFaultDetection = true
  echo "Starting calibration with disabled fault detection"
  M570 H3 P999999 T999999 R50    ; Disable chamber fault detection
else
  abort "Calibration cancelled by user."

; ---- Calibration method selection ----
M291 S4 K{"Automatic (T0+T1 avg)","Manual (IR/Probe)","Cancel"} R"Calibration Method" P"Select calibration method:<br><br>Automatic: Uses tool temperatures<br>Manual: You measure with IR/probe"

var useManualCalibration = false

if input == 0
  echo "Using automatic calibration - T0+T1 average temperature"
elif input == 1
  set var.useManualCalibration = true
  echo "Using manual calibration - you will measure temperature"
else
  abort "Calibration cancelled by user."

; ---- Heating duration selection ----
M291 S4 K{"30 minutes (Default)","Custom duration","Cancel"} R"Heating Duration" P"Select heating duration:<br><br>30 minutes is recommended for most cases.<br>Longer heating ensures better thermal stability."

var heatingMinutes = 30  ; Default heating duration

if input == 0
  echo "Using default heating duration: 30 minutes"
elif input == 1
  ; Ask for custom heating duration
  M291 J1 L5 H120 F30 P"Enter heating duration (5-120 minutes):<br><br>Recommended: 30-60 minutes<br>Minimum: 5 minutes for safety" R"Custom Heating Duration" S5
  if result == -1
    abort "Calibration cancelled by user."
  set var.heatingMinutes = input
  echo "Using custom heating duration: " ^ var.heatingMinutes ^ " minutes"
else
  abort "Calibration cancelled by user."

; ---- Safety preparations ----
M291 S4 K{"Continue","Cancel"} R"Remove Plastics" P"Remove low-temperature filaments from chamber.<br><br>This prevents damage during heating."

if input != 0
  ; Reset temperatures and abort
  M568 P0 S{0} R{0}
  M568 P1 S{0} R{0}  
  M568 P2 S{0} R{0}
  M568 P3 S{0} R{0}
  M140 S0
  M141 S0
  abort "Calibration cancelled - all temperatures reset."

M291 S2 R"Close Chamber" P"Close the chamber lid and door" S2

; Reset all heaters to safe state
M568 P0 S{0} R{0}
M568 P1 S{0} R{0}
M568 P2 S{0} R{0}
M568 P3 S{0} R{0}

; Home axes if needed
if !move.axes[0].homed||!move.axes[1].homed||!move.axes[2].homed||!move.axes[3].homed
  G28

; Move to safe position
G1 F18000 X-200 Y0 U200 Z150

; Check sensor health
var initialReading = sensors.analog[3].lastReading
echo "Initial chamber sensor reading: " ^ var.initialReading ^ "°C"

if var.initialReading > 1500 || var.initialReading < -50
  M140 S0
  M141 S0
  if var.disableFaultDetection
    M570 H3 P600 T70 R5
  echo "SENSOR FAULT: " ^ var.initialReading ^ "°C - Check wiring"
  abort "Chamber sensor fault detected"

echo "Sensor health check passed"

; Reset sensor to default configuration
M308 S3 A"Chamber Air" P"1.temp0" Y"thermistor" T200000 B3950 C0 R2200

;========= SIMPLIFIED HEATING PHASE =========
echo "=== HEATING PHASE ==="
echo "Setting chamber to 105°C and heating for " ^ var.heatingMinutes ^ " minutes"

; Set temperatures
M140 S160    ; Heat bed to 160°C
M141 S105    ; Heat chamber to 105°C

; Set status LED
M98 P"0:/sys/led/pause.g"

; User-selected heating period
var heatingStartTime = state.upTime
var heatingDuration = var.heatingMinutes * 60  ; Convert minutes to seconds
var lastHeatingUpdate = 0

echo "Heating chamber for " ^ var.heatingMinutes ^ " minutes..."
echo "Hold X or U endstop to skip heating period"

while !(sensors.endstops[0].triggered || sensors.endstops[3].triggered)
  var heatingRemaining = var.heatingDuration - (state.upTime - var.heatingStartTime)
  
  ; Check if heating is complete
  if var.heatingRemaining <= 0
    echo var.heatingMinutes ^ "-minute heating period complete"
    break
  
  ; Calculate variables outside conditional for proper scope
  var remainingMinutes = var.heatingRemaining / 60.0
  var currentTemp = (heat.heaters[0].current + heat.heaters[1].current) / 2
  
  ; Progress update every 2 minutes
  if (state.upTime - var.lastHeatingUpdate) >= 120 || var.lastHeatingUpdate == 0
    set var.lastHeatingUpdate = state.upTime
    echo "Heating - Time remaining: " ^ var.remainingMinutes ^ " minutes, Chamber: " ^ var.currentTemp ^ "°C"
    echo "(Hold X or U endstop to skip)"
  
  G4 S10  ; Wait 10 seconds

if sensors.endstops[0].triggered || sensors.endstops[3].triggered
  echo "Heating period skipped by endstop"
else
  echo var.heatingMinutes ^ "-minute heating complete"

;========= STABILIZATION PHASE =========
echo "=== STABILIZATION PHASE ==="
echo "Turning off chamber heater and waiting 5 minutes for stabilization"

; Turn off chamber heater completely
M141 S-273.15   ; Turn off chamber heater (absolute zero = off)
G4 S5

; 5-minute stabilization
var stabilizationStart = state.upTime
var stabilizationDuration = 300  ; 5 minutes = 300 seconds

echo "Stabilizing for 5 minutes..."
echo "Hold X or U endstop to skip stabilization"

while !(sensors.endstops[0].triggered || sensors.endstops[3].triggered)
  var stabilizationRemaining = var.stabilizationDuration - (state.upTime - var.stabilizationStart)
  
  if var.stabilizationRemaining <= 0
    echo "5-minute stabilization complete"
    break
  
  ; Update every 30 seconds
  if mod((state.upTime - var.stabilizationStart), 30) == 0
    var currentTemp = (heat.heaters[0].current + heat.heaters[1].current) / 2
    echo "Stabilizing - " ^ (var.stabilizationRemaining / 60.0) ^ " minutes remaining, Chamber: " ^ var.currentTemp ^ "°C"
  
  G4 S5

if sensors.endstops[0].triggered || sensors.endstops[3].triggered
  echo "Stabilization skipped by endstop"
else
  echo "Stabilization complete"

;========= CALIBRATION PHASE =========
echo "=== CALIBRATION PHASE ==="

; Physically disable chamber heater to prevent faults during calibration
echo "Disabling chamber heater to prevent heater faults during calibration"
M307 H3 A-1     ; Physically disable chamber heater (H3)
G4 S1           ; Brief pause for heater to disable

; Get reference temperature
var referenceTemp = 0.0
if var.useManualCalibration
  ; Manual measurement
  var currentTemp = (heat.heaters[0].current + heat.heaters[1].current) / 2
  M291 J1 L0 H200 F{var.currentTemp} P"Measure chamber temperature with IR gun or probe (°C):" R"Manual Temperature" S5
  if result == -1
    M140 S0
    abort "Calibration cancelled"
  set var.referenceTemp = input
  echo "Manual reference temperature: " ^ var.referenceTemp ^ "°C"
else
  ; Automatic - use T0+T1 average
  set var.referenceTemp = (heat.heaters[0].current + heat.heaters[1].current) / 2
  echo "Automatic reference temperature (T0+T1 avg): " ^ var.referenceTemp ^ "°C"

;========= BINARY SEARCH ALGORITHM =========
echo "Starting binary search calibration..."

; Initialize search parameters
var tolerance = 0.5      ; ±0.5°C accuracy target
var cLow = -5.0e-7      ; Lower bound
var cHigh = 5.0e-7      ; Upper bound
var bestC = 0.0         ; Best coefficient found
var bestError = 1.0e9   ; Best error achieved
var iterations = 0

echo "Binary search range: " ^ var.cLow ^ " to " ^ var.cHigh
echo "Target accuracy: ±" ^ var.tolerance ^ "°C"

; Binary search loop
while true
  set var.iterations = var.iterations + 1
  
  ; Calculate middle point
  var cMid = (var.cLow + var.cHigh) / 2.0
  
  ; Apply test coefficient
  M308 S3 C{var.cMid}
  G4 S5  ; Wait for stabilization
  
  ; Read sensor and calculate error
  var sensorReading = sensors.analog[3].lastReading
  var error = abs(var.sensorReading - var.referenceTemp)
  
  ; Update best values if improved
  if var.error < var.bestError
    set var.bestError = var.error
    set var.bestC = var.cMid
  
  ; Progress feedback every 5 iterations
  if mod(var.iterations, 5) == 0
    echo "Iteration " ^ var.iterations ^ ": C=" ^ var.cMid ^ ", Sensor=" ^ var.sensorReading ^ "°C, Error=" ^ var.error ^ "°C"
  
  ; Check convergence
  if (var.error <= var.tolerance) || (abs(var.cHigh - var.cLow) < 1e-9) || (var.iterations > 200)
    echo "Binary search complete after " ^ var.iterations ^ " iterations"
    echo "Best C coefficient: " ^ var.bestC
    echo "Best error: " ^ var.bestError ^ "°C"
    break
  
  ; Adjust search range
  if var.sensorReading > var.referenceTemp
    set var.cHigh = var.cMid  ; Reading too high, try lower C
  else
    set var.cLow = var.cMid   ; Reading too low, try higher C

;========= FORMAT AND SAVE RESULT =========
; Format coefficient for display
var cSign = (var.bestC < 0) ? "-" : ""
var cMagnitude = abs(var.bestC) / 1e-8
var cFormatted = ceil(var.cMagnitude * 100 - 0.5) / 100

echo "=== CALIBRATION COMPLETE ==="
echo "Final C coefficient: " ^ var.cSign ^ var.cFormatted ^ "e-8"
echo "Final error: " ^ var.bestError ^ "°C"
echo "Reference temperature: " ^ var.referenceTemp ^ "°C"
echo "Final sensor reading: " ^ sensors.analog[3].lastReading ^ "°C"

; Save configuration
var sensorConfig = "M308 S3 A\"Chamber Air\" P\"1.temp0\" Y\"thermistor\" T200000 B3950 C" ^ var.cSign ^ var.cFormatted ^ "e-8 R2200"
echo >"0:/user/ChamberTempSensor.g" var.sensorConfig
echo "Configuration saved to /user/ChamberTempSensor.g"

; Apply final configuration by running the saved file
echo "Applying calibrated sensor configuration..."
M98 P"0:/user/ChamberTempSensor.g"

;========= CLEANUP =========
; Turn off heaters
M140 S0
M141 S0

; Re-enable chamber heater (restore normal heater configuration)
echo "Re-enabling chamber heater to normal operation"
M307 H3 R2.430 C360.0 D5.50 S1.00 V0.0 B0     ; Re-enable chamber heater with normal parameters
G4 S2

; Restore fault detection if disabled
if var.disableFaultDetection
  echo "Restoring chamber fault detection"
  M570 H3 P600 T70 R5

; Success notification
M291 P"Calibration completed successfully!" R"Success" S2
M98 P"0:/sys/led/end.g"
G4 S3
M98 P"0:/sys/led/resetstatus.g"

echo "=== SIMPLIFIED CALIBRATION COMPLETE ==="
echo "Chamber sensor calibrated with C coefficient: " ^ var.cSign ^ var.cFormatted ^ "e-8"

;==============================================================================
; CALIBRATION COMPLETE
; Simplified process: Heat 30min → Stabilize 5min → Binary search → Save
;==============================================================================