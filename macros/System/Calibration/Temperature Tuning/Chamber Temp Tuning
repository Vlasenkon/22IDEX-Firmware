  echo "- Faulty chamber temperature sensor"  
  echo "- Wrong sensor configuration"
  echo "Please check chamber sensor wiring and configuration."
  abort "Cannot calibrate - Chamber sensor fault detected"

echo "Sensor health check passed - proceeding with calibration"

;========= BINARY SEARCH CALIBRATION ALGORITHM =========
; Use binary search to find optimal C coefficient for temperature sensor
; The C coefficient compensates for sensor variations and improves accuracy

; Initialize calibration parameters
var tol = 0.5        ; Tolerance: stop when within 0.5°C of target
var cLo = -5.0e-7    ; Lower bound of C coefficient search range
var cHi =  5.0e-7    ; Upper bound of C coefficient search range
var bestC = 0.0      ; Best C coefficient found so far (reverted to 0.0)
var bestErr = 1.0e9  ; Best error achieved so far (start with large value)
var cMid = 0.0       ; Current middle value being tested (reverted to 0.0)

echo "Starting calibration from C coefficient: 0.0 (binary search from -5e-7 to 5e-7)"

; Main calibration loop - binary search algorithm with adaptive target temperature
var iterations = 0
var skipEndstopCheck = false  ; Flag to skip endstop checks during calibration
while true
  ; Check for skip condition (X or U endstop triggered) only if not already in calibration
  if !var.skipEndstopCheck && (sensors.endstops[0].triggered || sensors.endstops[3].triggered)
    echo "Endstop detected - skipping to calibration phase"
    set var.skipEndstopCheck = true  ; Don't check endstops anymore during calibration iterations
  
  ; Recalculate target temperature based on calibration method
  if var.useManualCalibration
    ; Manual mode - keep fixed target temperature from user measurement
    set var.target = var.manualTargetTemp
  else
    ; Automatic mode - recalculate as current average of T0 and T1 for adaptive calibration
    set var.target = (heat.heaters[0].current + heat.heaters[1].current) / 2
  
  ; Calculate middle point of current search range
  set var.cMid = (var.cLo + var.cHi)/2.0
  
  ; Apply the test C coefficient to sensor 3 (chamber sensor)
  M308 S3 C{var.cMid}
  G4 S5  ; Wait for sensor reading to stabilize
  
  ; Read current temperature from sensor and calculate error against adaptive target
  var tNow = sensors.analog[3].lastReading
  var err  = abs(var.tNow - var.target)
  
  ; Progress feedback every 10 iterations
  set var.iterations = var.iterations + 1
  if mod(var.iterations, 10) == 0
    if var.useManualCalibration
      echo "Calibration iteration " ^ var.iterations ^ ": Target=" ^ var.target ^ "°C (Manual), Sensor=" ^ var.tNow ^ "°C, Error=" ^ var.err ^ "°C"
    else
      echo "Calibration iteration " ^ var.iterations ^ ": Target=" ^ var.target ^ "°C (T0=" ^ heat.heaters[0].current ^ "°C, T1=" ^ heat.heaters[1].current ^ "°C), Sensor=" ^ var.tNow ^ "°C, Error=" ^ var.err ^ "°C"
  
  ; Update best values if this attempt is better
  if (var.err < var.bestErr)
    set var.bestErr = var.err
    set var.bestC   = var.cMid
    echo "Attempting C coefficient: " ^ var.cMid ^ " with error " ^ var.bestErr ^ "°C"
  
  ; Check if we've found a good enough solution or search range is too small
  if (var.err <= var.tol) || (abs(var.cHi - var.cLo) < 5e-10)
    ; Format the final C coefficient for display and file output
    var scale = 100
    var cUnits = abs(var.bestC) / 1e-8
    var eps = 1e-9 * var.scale
    var cMant = ceil(var.cUnits * var.scale - 0.5 + var.eps) / var.scale
    var cSign = (var.bestC < 0) ? "-" : ""
    
    ; Display calibration results based on method used
    echo "=== CALIBRATION COMPLETE ==="
    echo "C coefficient = " ^ var.cSign ^ var.cMant ^ "e-8"
    if var.useManualCalibration
      echo "Calibration Method: Manual (User measured)"
      echo "Target Temperature (Manual): " ^ var.manualTargetTemp ^ "°C"
    else
      echo "Calibration Method: Automatic (T0+T1 average)"
      var finalTarget = (heat.heaters[0].current + heat.heaters[1].current) / 2
      echo "Final Target Temp (T0+T1 avg): " ^ var.finalTarget ^ "°C"
      echo "Final T0: " ^ heat.heaters[0].current ^ "°C, T1: " ^ heat.heaters[1].current ^ "°C"
    echo "Chamber Sensor Reading: " ^ sensors.analog[3].lastReading ^ "°C"
    echo "Final Error: " ^ var.bestErr ^ "°C"
    echo "Total iterations: " ^ var.iterations
    
    ; Save calibrated sensor configuration to file
    echo >"0:/user/ChamberTempSensor.g" "M308 S3 A""Chamber Air"" P""1.temp0"" Y""thermistor"" T200000 B3950 C" ^ var.cSign ^ var.cMant ^ "e-8 R2200"
    break  ; Exit calibration loop
  
  ; Adjust search range based on temperature reading vs adaptive target
  if (var.tNow > var.target)
    set var.cHi = var.cMid  ; Reading too high, search lower C values    
  else
    set var.cLo = var.cMid  ; Reading too low, search higher C values
  
  ; Safety timeout to prevent infinite loops (max 300 iterations)
  if var.iterations > 300
    ; If we still haven't achieved target, use best coefficient found
    if var.bestErr > var.tol
      echo "WARNING: Could not achieve target accuracy. Best error: " ^ var.bestErr ^ "°C"
      echo "Using best coefficient found. Consider checking sensor wiring or chamber conditions."
    break     


























;========= CALIBRATION COMPLETION AND CLEANUP =========
; Final sensor reading and temperature display
G4 S5   ; Brief pause for stability
M105    ; Report all temperatures

; Cool down all heating systems
M140 S0  ; Turn off bed heater
M141 S0  ; Turn off chamber heater

; Restore fault detection if it was disabled
