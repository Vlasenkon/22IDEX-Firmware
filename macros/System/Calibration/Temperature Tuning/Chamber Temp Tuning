if var.useManualCalibration
  ; Manual calibration - ask user to measure temperature
  M291 J1 L0 H300 F{var.chamberTargetTemp} P"Please measure the chamber air temperature using a pyrometer or thermocouple and enter the value (°C):" R"Enter measured temperature" S5
  if result == -1
    M140 S0  ; Turn off heaters
    M141 S0
    abort "Calibration cancelled by user."
  set var.manualTargetTemp = input
  set var.target = var.manualTargetTemp
  echo "Using manual target temperature: " ^ var.target ^ "°C (measured by user)"
else
  ; Automatic calibration - use T0+T1 average
  set var.target = (heat.heaters[0].current + heat.heaters[1].current) / 2
  echo "Using automatic target temperature: " ^ var.target ^ "°C (T0+T1 average)"


























; Check chamber sensor health before calibration
var initialSensorReading = sensors.analog[3].lastReading
echo "Initial chamber sensor reading: " ^ var.initialSensorReading ^ "°C"
echo "Target calibration temperature: " ^ var.target ^ "°C"

; Detect sensor faults (disconnected thermistor reads ~2000°C)
if var.initialSensorReading > 1500 || var.initialSensorReading < -50
  M140 S0  ; Turn off heaters for safety
  M141 S0
  ; Restore fault detection if it was disabled
  if var.disableFaultDetection
    M570 H3 P600 T70 R5
  M98 P"0:/sys/led/fault.g"  ; RED LED
  echo "SENSOR FAULT DETECTED:"
  echo "Chamber sensor reading: " ^ var.initialSensorReading ^ "°C"
