if !move.axes[1].homed||!move.axes[0].homed||!move.axes[3].homed||!move.axes[2].homed
  G28

if heat.heaters[0].current > 35 || heat.heaters[1].current > 35 ||heat.heaters[2].current > 35 || heat.heaters[3].current > 35
    M291 S2 R"Open the Lid and Door" P"Please Open the Lid and Door" S2

G1 F8000 X-208 Y175 U208 Z150
M568 P3 A0
M140 S0
M141 S0

if heat.heaters[0].current > 35 && heat.heaters[1].current > 35 && heat.heaters[2].current > 35 && heat.heaters[3].current > 35
    M291 R"Wait for Heater to Cool Down" P"The temperature of all heaters must be below 35°C." S1 T10
    while heat.heaters[0].current > 35 && heat.heaters[1].current > 35 && heat.heaters[2].current > 35 && heat.heaters[3].current > 35
        G4 S5

M291 S2 R"Attention!" P"Please take the low-temperature filament from the chamber" S2
M291 S2 R"Close the Lid and Door" P"Please Close the Lid and Door" S2

M140 S150
M141 S90
M116 H2 C0
G4 S1200

var target = ((heat.heaters[0].current+heat.heaters[1].current)/2)

;========= Binary search C coef =========
var tol = 0.2
var cLo = -1.5e-7
var cHi =  1.5e-7
var bestC = 0.0
var bestErr = 1.0e9
var cMid = 0.0

while true
  set var.cMid = (var.cLo + var.cHi)/2.0
  M308 S3 C{var.cMid}
  G4 S5
  var tNow = sensors.analog[3].lastReading
  var err  = abs(var.tNow - var.target)
  if (var.err < var.bestErr)
    set var.bestErr = var.err
    set var.bestC   = var.cMid
  if (var.err <= var.tol) || (abs(var.cHi - var.cLo) < 5e-10)
    var scale = 100
    var cUnits = abs(var.bestC) / 1e-8
    var eps = 1e-9 * var.scale
    var cMant = ceil(var.cUnits * var.scale - 0.5 + var.eps) / var.scale
    var cSign = (var.bestC < 0) ? "-" : ""
    echo "C coef = "^ {var.cSign} ^ {var.cMant}^ "e-8"
    echo "Mid Temp: "^ var.target ^"<br> Chamber Temp: "^ heat.heaters[3].current
    echo >"0:/user/ChamberTempSensor.g" "M308 S3 A""Chamber Air"" P""1.temp0"" Y""thermistor"" T200000 B3950 C" ^ {var.cSign} ^ {var.cMant} ^ "e-8 R2200"
    break
  if (var.tNow > var.target)
    set var.cHi = var.cMid      
  else
    set var.cLo = var.cMid     

G4 S5
M105


M140 S0
M141 S0
M98 P"0:/sys/led/end.g"
M291 P"Calibration completed successfully!" R"Success" S1 T15
M98 P"0:/sys/led/resetstatus.g"
