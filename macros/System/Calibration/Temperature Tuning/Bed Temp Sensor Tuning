if !move.axes[1].homed||!move.axes[0].homed||!move.axes[3].homed||!move.axes[2].homed
  G28

G1 F8000 X-208 Y175 U208 Z150
M568 P3 A0
M141 S0
M140 S0


var tol = 0.2                  ; accuracy
var soak = 60                  ; pause for stabilisation

;========= Ask for the Setpoint =========
M291 J1 L70 H200 F120 P"Enter the target bed heating temperature (°C)" R"Enter the target temperature" S5
if result == -1
  M140 S0
var setpoint = {input}

;Heat up and wait for stabilisation
M140 S{var.setpoint}
if sensors.analog[2].lastReading < var.setpoint
  M291 P"Please wait until the heating is finished." R"Heating in progres..." S1
  M116 H2

if sensors.analog[2].lastReading > var.setpoint
  M291 P"Please open door and wait until the bed has cooled to the desired temperature." R"Cooling in progress..." S1
  M116 H2


G4 S{var.soak}                 

;========= Ask for Measure Temp =========
M291 J1 L0 H200 F120 P"Please use a pyrometer to measure the temperature and enter its value (°C):" R"Enter the target temperature" S5
if result == -1
  M140 S0
var target = {input}

;========= Binary search C coef =========
var cLo = -1.5e-7
var cHi =  1.5e-7
var bestC = 0.0
var bestErr = 1.0e9
var cMid = 0.0
var deltaT = 0

while true
  set var.cMid = (var.cLo + var.cHi)/2.0
  set var.deltaT = sensors.analog[2].lastReading
  M308 S2 C{var.cMid}
  set var.deltaT = var.deltaT - sensors.analog[2].lastReading 
  M140 S{sensors.analog[2].lastReading + var.deltaT}
  G4 S1
  var tNow = sensors.analog[2].lastReading
  var err  = abs(var.tNow - var.target)
  if (var.err < var.bestErr)
    set var.bestErr = var.err
    set var.bestC   = var.cMid
  if (var.err <= var.tol) || (abs(var.cHi - var.cLo) < 5e-10)
    var scale = 100
    var cUnits = abs(var.bestC) / 1e-8
    var eps = 1e-9 * var.scale
    var cMant = ceil(var.cUnits * var.scale - 0.5 + var.eps) / var.scale
    var cSign = (var.bestC < 0) ? "-" : ""
    echo "C coef = "^ {var.cSign} ^ {var.cMant}^ "e-8"
    echo >"0:/user/BedTempCalibration.g" "M308 S2 A""Bed Heater"" P""1.temp1"" Y""thermistor"" T100000 B3950 C" ^ {var.cSign} ^ {var.cMant} ^ "e-8 R2200"
    break
  if (var.tNow > var.target)
    set var.cHi = var.cMid      
  else
    set var.cLo = var.cMid     

G4 S5
M105

M140 S0
M98 P"0:/sys/led/end.g"
M291 P{"Calibration completed successfully!"} R"Success" S1 T15
M98 P"0:/sys/led/resetstatus.g"
