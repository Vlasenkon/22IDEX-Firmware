var msg1 = "By enabling wait, the machine will wait for the chamber "
var msg2 = "to reach set temperature, then wait an additional 5 minutes "
var msg3 = "for heat soak before starting the print.<br>"
var msg4 = "Tip: To skip waiting for chamber temperature, set chamber temperature to 0 in your slicer."
var message = var.msg1 ^ var.msg2 ^ var.msg3 ^ var.msg4

M291 S4 P{var.message} R"Chamber Temperature Wait" K{"Wait","Don't Wait"} F0

if input = 0
    echo >"0:/user/chamberwait.g" "M116 H2 C0 S5 ; Wait for Chamber Temp"
    echo >>"0:/user/chamberwait.g" "if heat.heaters[3].active != 0 "
    echo >>"0:/user/chamberwait.g" "  G4 S300"
    echo "Wait for Chamber Temp selected"
else
    echo >"0:/user/chamberwait.g" "M116 H2 S10 ; Do not wait for Chamber Temp"
    echo "Don't wait for Chamber Temp selected"