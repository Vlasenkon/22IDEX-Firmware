var msg1 = "By enabling this option, the nozzle will be wiped during the print "
var msg2 = "every 500 cubic millimeters of plastic extruded.<br>"
var msg3 = "This will happen during layer changes.<br>"
var msg4 = "This is helpful for very oozy materials like PEI-9085, or PPSU."
var message = var.msg1 ^ var.msg2 ^ var.msg3 ^ var.msg4

M291 S4 R"Nozzle wiping during printing" P{var.message} K{"Enable","Disable"} F0

if input = 0
    echo >"0:/user/periodic_wiping.g" "if exists(global.periodic_wiping)"
    echo >>"0:/user/periodic_wiping.g" "  set global.periodic_wiping = 1"
    echo >>"0:/user/periodic_wiping.g" "else"
    echo >>"0:/user/periodic_wiping.g" "  global periodic_wiping = 1"
    echo "Nozzle wiping during printing is enabled"
else
    echo >"0:/user/periodic_wiping.g" "; Nozzle wiping during printing is disabled"
    echo "Nozzle wiping during printing is disabled"