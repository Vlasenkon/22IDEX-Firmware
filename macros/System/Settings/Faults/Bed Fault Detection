M291 R"Fault Detection" P"Select an option:" S4 K{"Enable","Disable"} F0

if input = 1
  M291 R"Warning!" P"Disabling Fault Detection is NOT RECOMMENDED and may cause fire, please do it ON YOUR OWN RISK and do not leave the printer unattended" S3
  echo >"0:/user/bedfaultdetection.g" "M570 H2 P999999 T999999 R50 ; Disable Bed Heater fault detection"
  M570 H2 P999999 T999999 R50
  echo "Fault Detection Disabled"
else
  echo >"0:/user/bedfaultdetection.g" "M570 H2 P30 T25 R3 ; Enable Bed Heater fault detection"
  M570 H2 P30 T25 R3
  echo "Fault Detection Enabled"