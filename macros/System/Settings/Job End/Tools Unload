M291 S4 K{"Always Retract", "Keep Filament Loaded", "Retract Once"} R"Retract Filament from Tool After Print" P"Filament will be retracted from the nozzle after print. This allows easy filament removal. Retraction only from active tool." F1

if input == 0
    echo >"0:/user/retractfinishbehavior.g" "; Filament Retraction After Print Mode - Always Retract Extended"
    echo >>"0:/user/retractfinishbehavior.g" "; Extended retract on both tools if they were used"
    echo >>"0:/user/retractfinishbehavior.g" "if state.currentTool >= 0"
    echo >>"0:/user/retractfinishbehavior.g" "  var currentTemp = heat.heaters[state.currentTool].active"
    echo >>"0:/user/retractfinishbehavior.g" "  if var.currentTemp > 50"
    echo >>"0:/user/retractfinishbehavior.g" "    var retractTemp = var.currentTemp - 50"
    echo >>"0:/user/retractfinishbehavior.g" "    M568 P{state.currentTool} S{var.retractTemp} R{var.retractTemp}"
    echo >>"0:/user/retractfinishbehavior.g" "    M116 P{state.currentTool} S5"
    echo >>"0:/user/retractfinishbehavior.g" "    M83"
    echo >>"0:/user/retractfinishbehavior.g" "    G1 E-150 F180  ; Retract 150mm at 3mm/s"
    echo >>"0:/user/retractfinishbehavior.g" "    M400"
    echo "Extended filament retraction enabled - will retract 150mm after each print"

elif input == 1
    echo >"0:/user/retractfinishbehavior.g" "; Filament Retraction After Print Mode - Skip Extended Retract"
    echo >>"0:/user/retractfinishbehavior.g" "; No additional retraction - basic 20mm retract already done in end.g"
    echo "Extended retraction disabled - only basic 20mm retract will be performed"

elif input == 2
    echo >"0:/user/retractfinishbehavior.g" "; Filament Retraction After Print Mode - Retract Extended Only Once"
    echo >>"0:/user/retractfinishbehavior.g" "if state.currentTool >= 0"
    echo >>"0:/user/retractfinishbehavior.g" "  var currentTemp = heat.heaters[state.currentTool].active"

    echo >>"0:/user/retractfinishbehavior.g" "    var retractTemp = var.currentTemp - 50"
    echo >>"0:/user/retractfinishbehavior.g" "    M568 P{state.currentTool} S{var.retractTemp} R{var.retractTemp}"
    echo >>"0:/user/retractfinishbehavior.g" "    M116 P{state.currentTool} S5"
    echo >>"0:/user/retractfinishbehavior.g" "    M83"
    echo >>"0:/user/retractfinishbehavior.g" "    G1 E-150 F180  ; Retract 150mm at 3mm/s"
    echo >>"0:/user/retractfinishbehavior.g" "    M400"
    echo >>"0:/user/retractfinishbehavior.g" "; Reset to skip mode after this print"
    echo >>"0:/user/retractfinishbehavior.g" "echo >""0:/user/retractfinishbehavior.g"" ""; Filament Retraction After Print Mode - Skip Extended Retract"""
    echo >>"0:/user/retractfinishbehavior.g" "echo >>""0:/user/retractfinishbehavior.g"" ""; No additional retraction - basic 20mm retract already done in end.g"""
    echo "Extended retraction will be performed only after the next print"