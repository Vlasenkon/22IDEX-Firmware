M291 S4 K{"Always Unload", "Never Unload", "Unload only after next print"} R"Tools Unloading after Print" P"Select Option"
if input == 0
    echo >"0:/user/retractfinishbehavior.g" "; Tools Unloading After Print Mode - Always Unload"
    echo >>"0:/user/retractfinishbehavior.g" "if exists(param.F)"
    echo >>"0:/user/retractfinishbehavior.g" "  T0"
    echo >>"0:/user/retractfinishbehavior.g" "  M98 P""0:/macros/System/Cold Pull"" A{param.F} C1"
    echo >>"0:/user/retractfinishbehavior.g" "if exists(param.S)"
    echo >>"0:/user/retractfinishbehavior.g" "  T1"
    echo >>"0:/user/retractfinishbehavior.g" "  M98 P""0:/macros/System/Cold Pull"" A{param.S} C1"
    echo "The Tools will Always Unload after printing is finished"
elif input == 1
    echo >"0:/user/retractfinishbehavior.g" "; Tools Unloading After Print Mode - Never Unload"
    echo >>"0:/user/retractfinishbehavior.g" "M98 P""0:/sys/nozzlewipe.g"""
    echo "The Tools will Never Unload after printing is finished"
elif input == 2
    echo >"0:/user/retractfinishbehavior.g" "; Tools Unloading After Print Mode - Unload only after next print"
    echo >>"0:/user/retractfinishbehavior.g" "if exists(param.F)"
    echo >>"0:/user/retractfinishbehavior.g" "  T0"
    echo >>"0:/user/retractfinishbehavior.g" "  M98 P""0:/macros/System/Cold Pull"" A{param.F} C1"
    echo >>"0:/user/retractfinishbehavior.g" "if exists(param.S)"
    echo >>"0:/user/retractfinishbehavior.g" "  T1"
    echo >>"0:/user/retractfinishbehavior.g" "  M98 P""0:/macros/System/Cold Pull"" A{param.S} C1"
    echo >>"0:/user/retractfinishbehavior.g" "echo >""0:/user/retractfinishbehavior.g"" ""; Tools Unloading After Print Mode - Never Unload"""
    echo >>"0:/user/retractfinishbehavior.g" "echo >>""0:/user/retractfinishbehavior.g"" ""M98 P""""0:/sys/nozzlewipe.g"""""""
    echo "The Tools will Unload only after the next print is finished"