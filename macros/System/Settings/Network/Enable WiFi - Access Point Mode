if exists(param.R)
    echo >"0:/user/networkmode.g" "M552 I1 S2 ; Enable WiFi Access Point mode"
    M99
    abort


M291 R"Change WiFi to AP Mode?" P{"Machine will share " ^ global.APname ^ " WiFi Network"} S4 K{"Change & Reconnect Now","Change and Reconnect Later","Cancel"}

if input = 0
    echo >"0:/user/networkmode.g" "M552 I1 S2 ; Enable WiFi Access Point mode"
    M552 I0 S0
    G4S1
    M552 I1 S0
    G4S1
    M98 P"0:/user/APname.g"
    M589 S{global.APname} P"1234567890" I192.168.0.1
    G4S2
    echo >"0:/IP_address.txt" "User was connected via WiFi Access Point mode"
    echo >>"0:/IP_address.txt" "Last Connected IP is: "^{network.interfaces[1].actualIP}

    M98 P"0:/user/networkmode.g"

elif input = 1
    echo >"0:/IP_address.txt" "User was connected via AP - Mode"
    echo >>"0:/IP_address.txt" "Last Connected IP is: "^{network.interfaces[1].actualIP}

    echo >"0:/user/networkmode.g" "M552 I1 S2 ; Enable WiFi Access Point mode"

elif input = 2
    abort
