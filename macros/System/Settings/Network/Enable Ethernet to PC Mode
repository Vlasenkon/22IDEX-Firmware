set global.ethernetToPCmode = 1

echo >"0:/user/ethernetToPCmode.g" "if exists(global.ethernetToPCmode)"
echo >>"0:/user/ethernetToPCmode.g" "  set global.ethernetToPCmode = "^{global.ethernetToPCmode}
echo >>"0:/user/ethernetToPCmode.g" "else"
echo >>"0:/user/ethernetToPCmode.g" "  global ethernetToPCmode = "^{global.ethernetToPCmode}


var ip = "192.168.1.50"
var subnet = "255.255.255.0"
var gateway = "192.168.1.1"

M291 R"Network Config" P{"IP: " ^ var.ip ^ "<br>Subnet: " ^ var.subnet ^ "<br>Gateway: " ^ var.gateway} S4 K{"Ok", "Change parameter", "Cancel"}
if input == 2
	set global.ethernetToPCmode = 0
	echo >"0:/user/ethernetToPCmode.g" "if exists(global.ethernetToPCmode)"
	echo >>"0:/user/ethernetToPCmode.g" "  set global.ethernetToPCmode = "^{global.ethernetToPCmode}
	echo >>"0:/user/ethernetToPCmode.g" "else"
	echo >>"0:/user/ethernetToPCmode.g" "  global ethernetToPCmode = "^{global.ethernetToPCmode}

	abort "Settings canceled by user"

if input == 1

	; Опитуємо IP-адресу з прикладом
	M291 S7 F{var.ip} R"Network Setup" P"Enter Static IP Address"
	set var.ip = input

	; Опитуємо шлюз з прикладом
	M291 S7 F{var.gateway} R"Network Setup" P"Enter Gateway"
	set var.gateway = input

	; Підтвердження
	M291 R"Confirm" P{"Apply these settings?<br>IP: " ^ var.ip ^ "<br>Subnet: " ^ var.subnet ^ "<br>Gateway: " ^ var.gateway} S3

	; Встановлюємо параметри
	if var.ip != "" && var.subnet != "" && var.gateway != ""
		echo >"0:/user/ip_ethernettopc.g" "M552 P"^{var.ip}^"                    ; Set static IP address"
    	echo >>"0:/user/ip_ethernettopc.g" "M553 P"^{var.subnet}^"                   ; Set subnet mask"
		echo >>"0:/user/ip_ethernettopc.g" "M554 P"^{var.gateway}^"                     ; Set gateway (optional)"
		echo >>"0:/user/ip_ethernettopc.g" "M552 S1                               ; Enable network interface"
	else
		M291 R"Error" P{"Please repet. IP: " ^ var.ip ^ "<br>Subnet: " ^ var.subnet ^ "<br>Gateway: " ^ var.gateway} S2
		M98 "0:/macros/System/Settings/Network/Enable Ethernet to PC Mode"


; Показати результат
M291 R"Network Config Applied" P{"IP: " ^ var.ip ^ "<br>Subnet: " ^ var.subnet ^ "<br>Gateway: " ^ var.gateway} S2
M291 R"Network Config Applied" P"Attention: The printer will now be restarted to save the settings." S2
M112 