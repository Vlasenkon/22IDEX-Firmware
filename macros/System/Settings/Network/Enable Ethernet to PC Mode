; Default Ethernet to PC configuration
var ip = "192.168.1.50"
var subnet = "255.255.255.0"
var gateway = "192.168.1.1"

if exists(param.R)
    echo >"0:/user/networkmode.g" {"M552 P" ^ var.ip ^ " I0 S1"}
    echo >>"0:/user/networkmode.g" {"M553 P" ^ var.subnet}
    echo >>"0:/user/networkmode.g" {"M554 P" ^ var.gateway}
    M99
    abort


; Step 1: Detect current network mode before making changes
var previousMode = "AP"                     ; Default to AP if no connection exists
var previousIP = "192.168.0.1"              ; Default AP IP

if network.interfaces[0].actualIP != "0.0.0.0"
  set var.previousIP = network.interfaces[0].actualIP
  if network.interfaces[0].actualIP == "192.168.1.50"
    set var.previousMode = "ETPC"           ; Ethernet to PC mode
  else
    set var.previousMode = "ETH"            ; Regular Ethernet mode
elif network.interfaces[1].actualIP != "0.0.0.0"
  set var.previousIP = network.interfaces[1].actualIP
  if network.interfaces[1].actualIP == "192.168.0.1"
    set var.previousMode = "AP"             ; WiFi Access Point mode
  else
    set var.previousMode = "CLIENT"         ; WiFi Client mode

M291 R"Ethernet to PC Mode" P"Choose how to configure connection:" S4 K{"Use default settings", "Use custom IP values", "Cancel"} F0

if input == 2
	abort "Script canceled by user"

; If user chose "Use custom IP values" (input == 1), prompt for settings
if input == 1
	M291 S7 F{var.ip} R"Network Setup" P"Enter Static IP Address or use default" J1
	set var.ip = input

	M291 S7 F{var.subnet} R"Network Setup" P"Enter Subnet Mask or use default" J1
	set var.subnet = input

	M291 S7 F{var.gateway} R"Network Setup" P"Enter Gateway or use default" J1
	set var.gateway = input

; If user chose "Use default settings" (input == 0), var.ip/subnet/gateway already set from lines 2-4

; Step 3: Validate inputs
if var.ip == "" || var.subnet == "" || var.gateway == ""
	M291 S1 R"Error" P{"Invalid settings. IP: " ^ var.ip ^ "<br>Subnet: " ^ var.subnet ^ "<br>Gateway: " ^ var.gateway} T0
	abort "Invalid network settings"

; Step 4: Show instructions and begin test
var instructMsg1 = "Configure your computer's Ethernet settings:<br>"
var instructMsg2 = "IP: 192.168.1.51 | Subnet: 255.255.255.0<br>"
var instructMsg3 = "Gateway: Leave empty or set to " ^ var.ip ^ "<br>"
var instructMsg4 = "<a href=https://wiki.visionminer.com/home/22IDEX/V3/PCEthernet target=_blank>Click here for full instructions</a>"
M291 R"Setup Required" P{var.instructMsg1 ^ var.instructMsg2 ^ var.instructMsg3 ^ var.instructMsg4} S3

var testMsg1 = "You will lose connection momentarily.<br>"
var testMsg2 = "Make sure Ethernet cable is connected between printer and computer.<br>"
var testMsg3 = "🟡 YELLOW - Testing<br>🟢 GREEN - Success<br>🔴 RED - Failed"
M291 R"Testing Connection" P{var.testMsg1 ^ var.testMsg2 ^ var.testMsg3} S4 K{"Ethernet cable is connected","Cancel"} F0

if input == 1
    M99
    abort

M98 P"0:/sys/led/pause.g"                   ; Yellow LED - testing

; Turn off both interfaces first
M552 I1 S-1                                 ; Turn off WiFi completely
G4 S1
M552 I0 S0                                  ; Turn off Ethernet
G4 S2

; Apply configuration
M553 P{var.subnet}                          ; Set subnet mask
M554 P{var.gateway}                         ; Set gateway
M552 P{var.ip} I0 S1                        ; Set IP and enable Ethernet

; Wait for connection
while network.interfaces[0].actualIP != var.ip && iterations < 20
	G4 S1                                   ; Wait 1 second per iteration (max 20 seconds)

; Check if connection was successful
if network.interfaces[0].actualIP == var.ip
	; Success - connection established
	M98 P"0:/sys/led/end.g"                 ; Green LED for success
	
	; Save configuration to networkmode.g using macro
	M98 P"0:/macros/System/Settings/Network/Enable Ethernet to PC Mode" R1
	
	; Exit - stay in this mode
	M99

; Failed - restore previous network mode
M98 P"0:/sys/led/fault.g"                   ; Red LED for failed connection

; Turn off both interfaces first (universal)
M552 I1 S-1                                 ; Turn off WiFi completely
G4 S1
M552 I0 S0                                  ; Turn off Ethernet
G4 S2

; Restore previous mode - only mode-specific enable commands
if var.previousMode == "ETH"
	M552 I0 S1                              ; Enable Ethernet
elif var.previousMode == "CLIENT"
	M552 I1 S0                              ; Set WiFi to idle
	G4 S5
	M552 I1 S1                              ; Enable as client
elif var.previousMode == "AP"
	M552 I1 S0                              ; Set WiFi to idle
	G4 S5
	M552 I1 S2                              ; Enable as access point
elif var.previousMode == "ETPC"
	M552 P192.168.1.50 I0 S1
	M553 P255.255.255.0
	M554 P192.168.1.1
else
	M552 I1 S0                              ; Set WiFi to idle
	G4 S5
	M552 I1 S2                              ; Enable as access point (default)

G4 S5
M291 S2 R"Connection Failed" P{"Ethernet to PC connection failed. Restored previous mode: " ^ var.previousIP}

M98 P"0:/sys/led/resetstatus.g"             ; Reset LEDs to normal