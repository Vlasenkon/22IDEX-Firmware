M204 P5000
;LAYER_CHANGE
;Z:9.8
;HEIGHT:0.2
set var.current_Layer = 48

;Set PA based on Layer
echo "Setting PA for Current Layer:", var.current_Layer

; PA Change Logic
if var.current_Layer <= var.Bottom_Buffer ; We are in the bottom buffer zone or below
  set var.calculated_PA = var.PA_MIN
  M572 D0:1 S{var.calculated_PA} ; Use minimum PA

elif var.current_Layer > var.RAMP_END_LAYER  ; We are in the top buffer zone or above
  set var.calculated_PA = var.PA_MAX
  M572 D0:1 S{var.calculated_PA} ; Use maximum PA

else
  ; We are in the ramping zone
  set var.calculated_PA = var.PA_MIN + (var.current_Layer - var.Bottom_Buffer) * var.PA_Multiplier
  M572 D0:1 S{var.calculated_PA}
  M106 S{var.FAN_SPEED}

echo >>"0:/sys/Result/PA.csv" {var.current_Layer ^ "," ^ move.axes[2].machinePosition ^ "," ^ move.extruders[{var.TOOL_ID}].pressureAdvance ^ "," ^ var.TOOL_ID}




