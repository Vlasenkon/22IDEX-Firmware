; thumbnail_QOI end
;
; 

; external perimeters extrusion width = 0.45mm
; perimeters extrusion width = 0.45mm
; infill extrusion width = 0.45mm
; solid infill extrusion width = 0.45mm
; top infill extrusion width = 0.40mm
; support material extrusion width = 0.40mm


M486 S0 A"Body1.stl"
M486 S-1


var TOOL_ID = 0
var Layer_MAX = 240
var Bottom_Buffer = 19
var Top_Buffer = 19


var current_Layer = 0
var current_Z = 0
var PA_Multiplier = 0
var calculated_PA = 0
echo >"0:/sys/Result/PA.csv"  "Layer,Z_Height,PA_Value,Tool_ID"


;––– Interactive Setup –––

; Lowest pressure advance
M291 P" " R"Enter lowest Pressure Advance (seconds):" S6 L0 H1.5 F0 J1  ; prompt user
var PA_MIN = input                                          ; store lower bound

; Highest pressure advance
M291 P" " R"Enter highest Pressure Advance (seconds):" S6 L0 H1.5 F0.15 ; prompt user
var PA_MAX = input                                          ; store upper bound

; Nozzle selection
M291 R"Select active nozzle:" P" " K{"Left","Right"} S4           ; two-button choice
;    “Left” → input=0, “Right” → input=1
if input == 1
   set var.TOOL_ID = 1

; Tool temperature for selected nozzle
M291 R"Enter temperature for selected nozzle (°C):" P" " S6 L0 H500 F270
var TOOL_TEMP = input
M568 P{var.TOOL_ID} S{var.TOOL_TEMP} R{var.TOOL_TEMP} ; Set Active AND Standby temps and wait

; Build plate temperature
M291 P" " R"Enter build plate temperature (°C):" S6 L0 H200 F120
var BED_TEMP = input
M140 S{var.BED_TEMP}


; Fan Speed
M291 P" " R"Enter Fan Speed in %:" S6 L0 H100 F50
var FAN_SPEED = input / 100

M106 S0



; --- Calculate PA ramp parameters ---
var RAMP_START_LAYER = var.Bottom_Buffer + 1
var RAMP_END_LAYER = var.Layer_MAX - var.Top_Buffer
var RAMP_LAYER_COUNT = var.RAMP_END_LAYER - var.Bottom_Buffer ; Number of layers in the ramp zone

; Prevent division by zero if buffers overlap or consume the whole range
if var.RAMP_LAYER_COUNT <= 0
  echo "Warning: Bottom_Buffer and Top_Buffer leave no room for PA ramp. Using PA_MIN."
  set var.PA_Multiplier = 0 ; Effectively disables ramping
else
  set var.PA_Multiplier = (var.PA_MAX - var.PA_MIN) / var.RAMP_LAYER_COUNT

echo "Ramp Start Layer:", var.RAMP_START_LAYER
echo "Ramp End Layer:", var.RAMP_END_LAYER
echo "Ramp Layer Count:", var.RAMP_LAYER_COUNT
echo "PA Multiplier per layer:", var.PA_Multiplier
echo "Fan Speed:", var.FAN_SPEED



;TYPE:Custom
M98 P"0:/sys/initial.g" A-33.0667 B33.0667 D-38.2466 J38.1431
G21 ; set units to millimeters
G90 ; use absolute coordinates
M83 ; use relative distances for extrusion
; Filament gcode
M572 D0:1 S0.045 ; Set Pressure Advance
M107
;LAYER_CHANGE
;Z:0.2
;HEIGHT:0.2
G1 E-1 F6000
G1 Z.2 F1800
G1 X-20.651 Y20.65 F18000
G1 Z.2 F1800
G1 E1 F3000
M204 P1000
