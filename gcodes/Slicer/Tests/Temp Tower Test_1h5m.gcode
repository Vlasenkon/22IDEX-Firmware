; thumbnail_QOI end
;
; 

; external perimeters extrusion width = 0.45mm
; perimeters extrusion width = 0.45mm
; infill extrusion width = 0.45mm
; solid infill extrusion width = 0.45mm
; top infill extrusion width = 0.40mm
; support material extrusion width = 0.40mm


M486 S0 A"Body1.stl"
M486 S-1

;TYPE:Custom

var numTempSteps = 6


var TOOL_ID = 0
var current_Layer = 0
var current_Z = 0
echo >"0:/sys/Tuning/Temp.csv"  "Layer #,Z_Height,Tool_ID,Temp (Set),Temp (Actual)"


;––– Interactive Setup –––


; Nozzle selection
M291 R"Select active nozzle:" P" " K{"Left","Right"} S4           ; two-button choice
;    “Left” → input=0, “Right” → input=1
if input == 1
   set var.TOOL_ID = 1

M291 P" " R"Enter lowest temperature (°C):" S6 L160 H500 F240 J1  ; prompt user
var TEMP_MIN = input                                          ; store lower bound

M291 P" " R"Enter highest temperature (°C):" S6 L160 H500 F290 ; prompt user
var TEMP_MAX = input                                          ; store upper bound

M568 P{var.TOOL_ID} S{var.TEMP_MIN} R{var.TEMP_MIN} ; Set Active AND Standby temps and wait

; Build plate temperature
M291 P" " R"Enter build plate temperature (°C):" S6 L0 H200 F120
var BED_TEMP = input
M140 S{var.BED_TEMP}


; Fan Speed
;M291 P" " R"Enter Fan Speed in %:" S6 L0 H100 F50
;var FAN_SPEED = input / 100
M106 S0


var Temp_Setep = (var.TEMP_MAX - var.TEMP_MIN) / (var.numTempSteps - 1)


var temp1 = var.TEMP_MIN
var temp2 = var.TEMP_MIN + var.Temp_Setep * 1
var temp3 = var.TEMP_MIN + var.Temp_Setep * 2
var temp4 = var.TEMP_MIN + var.Temp_Setep * 3
var temp5 = var.TEMP_MIN + var.Temp_Setep * 4
var temp6 = var.TEMP_MIN + var.Temp_Setep * 5



echo "Temp for Segment 1:", var.temp1
echo "Temp for Segment 2:", var.temp2
echo "Temp for Segment 3:", var.temp3
echo "Temp for Segment 4:", var.temp4
echo "Temp for Segment 5:", var.temp5
echo "Temp for Segment 6:", var.temp6





M98 P"0:/sys/initial.g" A-21.7323 B21.7323 D-15.3862 J15.3863
G21 ; set units to millimeters
G90 ; use absolute coordinates
M83 ; use relative distances for extrusion
; Filament gcode
M572 D0:1 S0.045 ; Set Pressure Advance
M107
;LAYER_CHANGE
;Z:0.2
;HEIGHT:0.2
G1 E-1 F6000
G1 Z.2 F1800
G1 X0 Y-15.183 F18000
G1 Z.2 F1800
G1 E1 F3000
M204 P1000
;TYPE:Skirt/Brim
