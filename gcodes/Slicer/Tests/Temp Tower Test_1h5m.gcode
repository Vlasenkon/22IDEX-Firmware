M204 P5000
;LAYER_CHANGE
;Z:74.8
;HEIGHT:0.200005
set var.current_Layer = 373




;Set Temp based on Layer

if var.current_Layer < 86
  M104 S{var.temp1}
elif var.current_Layer < 167
  M104 S{var.temp2}
elif var.current_Layer < 248
  M104 S{var.temp3}
elif var.current_Layer < 329
  M104 S{var.temp4}
elif var.current_Layer < 411
  M104 S{var.temp5}
else
  M104 S{var.temp6}

M106 S{var.FAN_SPEED}
echo >>"0:/sys/Tuning/Temp.csv" {var.current_Layer ^ "," ^ move.axes[2].machinePosition ^ ","  ^ var.TOOL_ID ^ "," ^ heat.heaters[{var.TOOL_ID}].active ^ "," ^ heat.heaters[{var.TOOL_ID}].current}




