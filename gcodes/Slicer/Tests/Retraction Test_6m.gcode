; 

; external perimeters extrusion width = 0.45mm
; perimeters extrusion width = 0.45mm
; infill extrusion width = 0.45mm
; solid infill extrusion width = 0.45mm
; top infill extrusion width = 0.40mm
; support material extrusion width = 0.40mm


M486 S0 A"Body1.stl"
M486 S-1

;TYPE:Custom


var TOOL_ID = 0
var current_Layer = 0
var current_Z = 0


;––– Interactive Setup –––


; Nozzle selection
M291 R"Select active nozzle:" P" " K{"Left","Right"} S4           ; two-button choice
;    “Left” → input=0, “Right” → input=1
if input == 1
   set var.TOOL_ID = 1

M291 P" " R"Enter temperature for selected nozzle (°C):" S6 L160 H500 F240 J1  ; prompt user
var NOZZLE_TEMP = input                                          ; store lower bound

M568 P{var.TOOL_ID} S{var.NOZZLE_TEMP} R{var.NOZZLE_TEMP} ; Set Active AND Standby temps and wait

; Build plate temperature
M291 P" " R"Enter build plate temperature (°C):" S6 L0 H200 F120
var BED_TEMP = input
M140 S{var.BED_TEMP}


; Fan Speed
;M291 P" " R"Enter Fan Speed in %:" S6 L0 H100 F50
;var FAN_SPEED = input / 100
M106 S0

M291 P" " R"Enter Pressure Advance (seconds):" S6 L0 H1.5 F0 J1  ; prompt user
var PA = input                                          ; store lower bound

M572 D0:1 S{var.PA}

M98 P"0:/sys/initial.g" A-19.0416 B19.0416 D-18.7088 J17.1232
G21 ; set units to millimeters
