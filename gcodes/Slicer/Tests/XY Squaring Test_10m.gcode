; start_filament_gcode = "; Filament gcode\nset var.nozz_03 = 0.05\nset var.nozz_04 = 0.035\nset var.nozz_05 = 0.01\n\nset global.extrusion_value = 20\nset global.retraction_value = -2\n\n{if nozzle_diameter[0] <= 0.3}\nM572 D0 S{\"{var.nozz_03}\"}\n{elsif nozzle_diameter[0] == 0.4}\nM572 D0 S{\"{var.nozz_04}\"}\n{elsif nozzle_diameter[0] >= 0.5}\nM572 D0 S{\"{var.nozz_05}\"}\n{endif}\n\n{if nozzle_diameter[1] <= 0.3}\nM572 D1 S{\"{var.nozz_03}\"}\n{elsif nozzle_diameter[1] == 0.4}\nM572 D1 S{\"{var.nozz_04}\"}\n{elsif nozzle_diameter[1] >= 0.5}\nM572 D1 S{\"{var.nozz_05}\"}\n{endif}";"; Filament gcode\nset var.nozz_03 = 0.05\nset var.nozz_04 = 0.035\nset var.nozz_05 = 0.01\n\nset global.extrusion_value = 20\nset global.retraction_value = -2\n\n{if nozzle_diameter[0] <= 0.3}\nM572 D0 S{\"{var.nozz_03}\"}\n{elsif nozzle_diameter[0] == 0.4}\nM572 D0 S{\"{var.nozz_04}\"}\n{elsif nozzle_diameter[0] >= 0.5}\nM572 D0 S{\"{var.nozz_05}\"}\n{endif}\n\n{if nozzle_diameter[1] <= 0.3}\nM572 D1 S{\"{var.nozz_03}\"}\n{elsif nozzle_diameter[1] == 0.4}\nM572 D1 S{\"{var.nozz_04}\"}\n{elsif nozzle_diameter[1] >= 0.5}\nM572 D1 S{\"{var.nozz_05}\"}\n{endif}"
; start_gcode = {if first_layer_bed_temperature[0] >= first_layer_bed_temperature[1]}\nM140 S{first_layer_bed_temperature[0]}\n\n{elsif first_layer_bed_temperature[1] >= first_layer_bed_temperature[0]}\nM140 S{first_layer_bed_temperature[0]}\n{endif}\n\n{if chamber_temperature[0] >= chamber_temperature[1]}\nM141 S{chamber_temperature[0]}\n\n{elsif chamber_temperature[1] >= chamber_temperature[0]}\nM141 S{chamber_temperature[1]}\n{endif}\n\n\n\n{if is_extruder_used[0] && is_nil(idle_temperature[0]) != true}\nM568 P0 S{first_layer_temperature[0]} R{idle_temperature[0]}\n\n{elsif is_extruder_used[0] && is_nil(idle_temperature[0]) == true}\nM568 P0 S{first_layer_temperature[0]} R{first_layer_temperature[0]}\n{endif}\n\n\n\n{if is_extruder_used[1] && is_nil(idle_temperature[1]) != true}\nM568 P1 S{first_layer_temperature[1]} R{idle_temperature[1]}\n\n{elsif is_extruder_used[1] && is_nil(idle_temperature[1]) == true}\nM568 P1 S{first_layer_temperature[1]} R{first_layer_temperature[1]}\n{endif}\n\n\nM98 P"0:/sys/initial.g" E{current_extruder} A{first_layer_print_min[0]} B{first_layer_print_max[0]} D{first_layer_print_min[1]} J{first_layer_print_max[1]}\n\nvar nozz_03 = 0.05\nvar nozz_04 = 0.035\nvar nozz_05 = 0.01\n\nvar hepacount = 0\n\n{if total_toolchanges > 0}\nvar toolchange_count = 0\n{endif}\n\n\n{if filament_type[0] == "ULTEM 1010" || filament_type[0] == "ULTEM 9085"}\nvar clean0 = 500\n{endif}\n\n{if filament_type[1] == "ULTEM 1010" || filament_type[1] == "ULTEM 9085"}\nvar clean1 = 500\n{endif}
