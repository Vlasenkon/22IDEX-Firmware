; layer_gcode = {if layer_num == 1}\nM221 D0 S100\nM221 D1 S100\n{endif} \n\n\n{if filament_type[0] == "ULTEM 1010" || filament_type[0] == "ULTEM 9085"}\n{if filament_type[1] == "ULTEM 1010" || filament_type[1] == "ULTEM 9085"}\n\nG60 S0\n\n{if is_extruder_used[0] == true}\nT0\nif {"{global.periodic_wiping}"} == 1\n  if {extruded_volume[0]} >= var.clean0\n    set var.clean0 = var.clean0 + 500\n    M400\n    G60 S4\n    M83\n    G1 E-5 F1200\n    G91\n    G1 Z2 F12000\n    G90\n    M400\n    M98 P"0:/sys/nozzlewipe.g" W1 C5\n    M400\n    G1 E20 F180\n    G1 E-2 F1200\n    G1 R4 X0 Y0 F18000\n    G91\n    G1 Z-2\n    G90\n    M400\n{endif}\n\n{if is_extruder_used[1] == true}\nT1\nif {"{global.periodic_wiping}"} == 1\n  if {extruded_volume[1]} >= var.clean1\n    M400\n    G60 S4\n    M83\n    G1 E-5 F1200\n    G91\n    G1 Z2 F12000\n    G90\n    M400\n    M98 P"0:/sys/nozzlewipe.g" W1 C5\n    M400\n    G1 E20 F180\n    G1 E-2 F1200\n    G1 R4 X0 Y0 F18000\n    G91\n    G1 Z-2\n    G90\n    M400\n{endif}\n\nT R0\n\n{endif}\n{endif}\n\nif {"{global.hepafan}"} > 0\n  if {"{fans[7].rpm}"} < 500\n  set var.hepacount = var.hepacount + 1\n    if {"{var.hepacount}"} >= 10\n    M106 P7 S0
